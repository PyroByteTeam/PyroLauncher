<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PyroLauncher</RootNamespace>
    <Version>1.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Lang/*.json" LogicalName="Lang.%(Filename).json" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>

</Project>
