<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:PyroLauncher.Desktop">
    <Styles.Resources>
        <ResourceDictionary>
            <Color x:Key="C.Bg0">#FF080808</Color>
            <Color x:Key="C.Bg1">#FF0F0F0F</Color>
            <Color x:Key="C.Bg2">#FF151515</Color>
            <Color x:Key="C.Bg3">#FF1D1D1D</Color>
            <Color x:Key="C.Bg4">#FF262626</Color>
            <SolidColorBrush x:Key="Bg0" Color="#FF080808"/>
            <SolidColorBrush x:Key="Bg1" Color="#FF0F0F0F"/>
            <SolidColorBrush x:Key="Bg2" Color="#FF151515"/>
            <SolidColorBrush x:Key="Bg3" Color="#FF1D1D1D"/>
            <SolidColorBrush x:Key="Bg4" Color="#FF262626"/>
            <SolidColorBrush x:Key="Line" Color="#FF262626"/>
            <SolidColorBrush x:Key="Line2" Color="#FF404040"/>
            <SolidColorBrush x:Key="Fg" Color="#FFF4F4F4"/>
            <SolidColorBrush x:Key="Fg2" Color="#FFC4C4C4"/>
            <SolidColorBrush x:Key="Fg3" Color="#FF959595"/>
            <SolidColorBrush x:Key="Accent" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="AccentFg" Color="#FF000000"/>
            <SolidColorBrush x:Key="AccentHover" Color="#FFDADADA"/>
            <!-- Layers over the optional background image (set by ThemeService) -->
            <SolidColorBrush x:Key="WindowTint" Color="#00000000"/>
            <SolidColorBrush x:Key="SidebarBg" Color="#FF0F0F0F"/>
            <SolidColorBrush x:Key="Scrim" Color="#CC000000"/>
            <SolidColorBrush x:Key="LogInfo" Color="#FFC4C4C4"/>
            <SolidColorBrush x:Key="LogWarn" Color="#FFE8C468"/>
            <SolidColorBrush x:Key="LogError" Color="#FFFF6B6B"/>
            <SolidColorBrush x:Key="LogDebug" Color="#FF8A8A8A"/>
            <SolidColorBrush x:Key="LogLauncher" Color="#FFFFFFFF"/>

            <FontFamily x:Key="UiFont">fonts:Inter#Inter, $Default</FontFamily>
            <FontFamily x:Key="IconFont">avares://PyroLauncher/Assets/lucide.ttf#lucide</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>

            <!-- Fluent overrides: black & white -->
            <SolidColorBrush x:Key="ToolTipBackground" Color="#FF1D1D1D"/>
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FF3A3A3A"/>
            <SolidColorBrush x:Key="ToolTipForeground" Color="#FFF4F4F4"/>
            <SolidColorBrush x:Key="TextControlBackground" Color="#FF151515"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF1D1D1D"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF151515"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF262626"/>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF3A3A3A"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF959595"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF959595"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF959595"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF959595"/>
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF151515"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF1D1D1D"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FF262626"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FF3A3A3A"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF151515"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FF3A3A3A"/>
            <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#FF262626"/>
            <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#FF2C2C2C"/>
            <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#FF1D1D1D"/>
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF151515"/>
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#FF3A3A3A"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FF000000"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FF000000"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FF000000"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFC4C4C4"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFF4F4F4"/>
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FF000000"/>
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FF000000"/>
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="#FF000000"/>
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="{l:F 28}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="{l:F 18}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.h3"><Setter Property="FontSize" Value="{l:F 15}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource Fg2}"/><Setter Property="FontSize" Value="{l:F 13.5}"/></Style>
    <Style Selector="TextBlock.faint"><Setter Property="Foreground" Value="{StaticResource Fg3}"/><Setter Property="FontSize" Value="{l:F 13}"/></Style>
    <Style Selector="TextBlock.overline">
        <Setter Property="Foreground" Value="{StaticResource Fg3}"/>
        <Setter Property="FontSize" Value="{l:F 12}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="0.6"/>
    </Style>
    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/></Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource Bg2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.card.clickable"><Setter Property="Cursor" Value="Hand"/></Style>
    <Style Selector="Border.card.clickable:pointerover"><Setter Property="BorderBrush" Value="{StaticResource Fg3}"/></Style>
    <Style Selector="Border.row">
        <Setter Property="Background" Value="{StaticResource Bg3}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Border.row.hover:pointerover"><Setter Property="Background" Value="{StaticResource Bg4}"/></Style>
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{StaticResource Bg3}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.badgeText"><Setter Property="FontSize" Value="{l:F 12}"/><Setter Property="Foreground" Value="{StaticResource Fg2}"/></Style>
    <Style Selector="Border.settingRow">
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,14"/>
    </Style>
    <Style Selector="Border.dialog">
        <Setter Property="Background" Value="{StaticResource Bg2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="28,24"/>
        <Setter Property="BoxShadow" Value="0 8 40 0 #B0000000"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource Bg3}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- Instance and server cards -->
    <Style Selector="Border.instanceCard">
        <Setter Property="Background" Value="{StaticResource Bg2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.instanceCard:pointerover"><Setter Property="BorderBrush" Value="{StaticResource Line2}"/></Style>
    <Style Selector="Border.instanceCard Button.play"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Border.instanceCard:pointerover Button.play"><Setter Property="IsVisible" Value="True"/></Style>
    <Style Selector="Border.instanceCard.active Button.play"><Setter Property="IsVisible" Value="True"/></Style>
    <Style Selector="Border.instanceCard Button.play.always"><Setter Property="IsVisible" Value="True"/></Style>
    <Style Selector="Button.play">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="21"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentFg}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="{l:F 16}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentHover}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentFg}"/>
    </Style>
    <!-- Theme picker cards (Settings → Appearance) -->
    <Style Selector="Button.themeCard">
        <Setter Property="Background" Value="{StaticResource Bg2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.themeCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Bg3}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Fg3}"/>
    </Style>
    <Style Selector="Button.themeCard.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>
    <Style Selector="Button.themeCard.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>
    <!-- Window caption buttons: Windows sets the arrow cursor over them itself; a hand here makes it flicker. -->
    <Style Selector="CaptionButtons /template/ Button">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Bg4}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource Bg2}"/></Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Bg2}"/>
        <Setter Property="Foreground" Value="{StaticResource Fg3}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentFg}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentHover}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentHover}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentFg}"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Bg4}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
        <Setter Property="Foreground" Value="{StaticResource Fg3}"/>
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Bg3}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="{l:F 16}"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Bg3}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    </Style>
    <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Sidebar entry: icon (Tag) above the label -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Foreground" Value="{StaticResource Fg3}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Height="{l:S 62}" Background="Transparent">
                    <Border x:Name="pill" Width="4" Height="{l:S 22}" CornerRadius="0,2,2,0" Background="{StaticResource Accent}" HorizontalAlignment="Left" IsVisible="False"/>
                    <Border x:Name="bg" Width="{l:S 76}" Height="{l:S 56}" CornerRadius="10" HorizontalAlignment="Center">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="{l:S 19}" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock Text="{TemplateBinding Content}" FontSize="{l:S 11}" Margin="{l:S '0,4,0,0'}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="{l:S 72}" Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
    <Style Selector="RadioButton.nav:checked"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#bg"><Setter Property="Background" Value="{StaticResource Bg3}"/></Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#pill"><Setter Property="IsVisible" Value="True"/></Style>

    <!-- Underlined tab with an optional icon in Tag -->
    <Style Selector="RadioButton.tab">
        <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="{l:TM '0,0,22,0'}"/>
        <Setter Property="FontSize" Value="{l:TF 14}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <StackPanel Orientation="Horizontal" Margin="{l:TM '0,8,0,11'}">
                        <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="{l:TF 14}" Margin="{l:TM '0,0,7,0'}" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" IsVisible="{TemplateBinding Tag, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <Border x:Name="line" Height="2" VerticalAlignment="Bottom" Background="{StaticResource Accent}" CornerRadius="1" IsVisible="False"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.tab:pointerover"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
    <Style Selector="RadioButton.tab:checked"><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="RadioButton.tab:checked /template/ Border#line"><Setter Property="IsVisible" Value="True"/></Style>

    <Style Selector="RadioButton.segment">
        <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
        <Setter Property="Background" Value="{StaticResource Bg2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover"><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter Property="Background" Value="{StaticResource Bg3}"/></Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentFg}"/>
    </Style>

    <!-- Toggle without chrome (expanders, headers) -->
    <Style Selector="ToggleButton.plain">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Background="Transparent" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"/>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- Fluent paints the selection with the accent (white) under white text -->
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="SelectionForegroundBrush" Value="{StaticResource AccentFg}"/>
    </Style>
    <Style Selector="SelectableTextBlock">
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="SelectionForegroundBrush" Value="{StaticResource AccentFg}"/>
    </Style>
    <!-- List rows: rounded, and no accent fill while pressed or freshly selected -->
    <Style Selector="ListBoxItem"><Setter Property="CornerRadius" Value="8"/></Style>
    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Bg4}"/>
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Bg4}"/>
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ListBoxItemBackgroundSelectedPointerOver}"/>
    </Style>
    <Style Selector="TextBox.search"><Setter Property="Padding" Value="32,7,10,7"/></Style>
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="Background" Value="{StaticResource Bg4}"/>
        <Setter Property="MinHeight" Value="4"/>
        <Setter Property="Height" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value=""/>
        <Setter Property="OffContent" Value=""/>
    </Style>
    <Style Selector="ScrollViewer"><Setter Property="AllowAutoHide" Value="True"/></Style>
</Styles>
