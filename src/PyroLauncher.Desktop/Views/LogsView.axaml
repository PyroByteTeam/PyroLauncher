<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PyroLauncher.Desktop"
             xmlns:i="clr-namespace:PyroLauncher.Desktop"
             xmlns:c="clr-namespace:PyroLauncher.Desktop.Controls"
             x:Class="PyroLauncher.Desktop.Views.LogsView">
    <Grid Margin="0,0,0,16" RowDefinitions="Auto,*">
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <CheckBox Content="{l:T 'Errors &amp; warnings'}" IsChecked="{Binding #Viewer.ErrorsOnly}" Margin="0,0,6,0"/>
                <Button Content="{l:T 'Open console'}" Command="{Binding OpenConsoleCommand}" IsVisible="{Binding ConsoleEnabled}"/>
                <Button Content="{l:T 'Copy'}" Click="Copy_Click" ToolTip.Tip="{l:T 'Copy selected lines (or everything)'}"/>
                <Button Content="{l:T 'Clear'}" Command="{Binding ClearCommand}"/>
                <Button Content="{l:T 'Crash reports'}" Command="{Binding OpenCrashReportsCommand}"/>
                <Button Content="{l:T 'Logs folder'}" Command="{Binding OpenLogsFolderCommand}"/>
            </StackPanel>
            <Grid Margin="0,0,16,0">
                <TextBox x:Name="FilterBox" Classes="search" Watermark="{l:T 'Filter lines…'}"/>
                <TextBlock Classes="icon" Text="{i:I E721}" Foreground="{StaticResource Fg3}" FontSize="12" Margin="12,0,0,0" IsHitTestVisible="False"/>
            </Grid>
        </DockPanel>
        <c:LogViewer x:Name="Viewer" Grid.Row="1" Lines="{Binding Instance.LogLines}" Filter="{Binding #FilterBox.Text}"/>
    </Grid>
</UserControl>
