<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PyroLauncher.Desktop"
             xmlns:i="clr-namespace:PyroLauncher.Desktop"
             xmlns:c="clr-namespace:PyroLauncher.Desktop.Controls"
             x:Class="PyroLauncher.Desktop.Views.ServerSetupView">
    <Border Classes="dialog" Width="560">
        <StackPanel>
            <TextBlock Classes="h2" Text="{l:T 'Set up the server'}"/>
            <TextBlock Classes="muted" Margin="0,4,0,0" TextWrapping="Wrap">
                <Run Text="{Binding Pack.Name}" FontWeight="SemiBold"/> <Run Text="{l:T 'is installed. Two things before the first start:'}"/>
            </TextBlock>

            <TextBlock Classes="overline" Text="{l:T 'MEMORY'}" Margin="0,20,0,6"/>
            <c:MemoryPicker Value="{Binding MemoryMb}"/>
            <TextBlock Classes="faint" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="{l:T 'Modded servers usually need 4-8 GB, larger packs more. You can change it later in the server settings.'}"/>

            <TextBlock Classes="overline" Text="{l:T 'MINECRAFT EULA'}" Margin="0,20,0,6"/>
            <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Fg2}"
                               Text="{l:T 'To run a Minecraft server you have to accept the Minecraft End User License Agreement. Accepting writes eula=true to the server folder; cancelling leaves the server off.'}"/>
                    <Button Classes="ghost" Command="{Binding OpenEulaCommand}" Padding="0,6" Margin="0,6,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon" Text="{i:I E8A7}" FontSize="12"/>
                            <TextBlock Text="{l:T 'Read the EULA'}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Classes="faint" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="{l:T 'server.properties has already been created, so you can change the port, game mode, whitelist and more before the first start.'}"/>

            <DockPanel Margin="0,20,0,0">
                <Button DockPanel.Dock="Right" Classes="primary" Command="{Binding AcceptCommand}" Content="{l:T 'Accept EULA'}"/>
                <Button DockPanel.Dock="Right" Content="{l:T 'Cancel'}" Command="{Binding CancelCommand}" Margin="0,0,8,0" IsCancel="True"/>
                <Button Classes="ghost" Command="{Binding OpenPropertiesCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="{i:I E713}" FontSize="12"/>
                        <TextBlock Text="{l:T 'Accept and edit properties'}"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
