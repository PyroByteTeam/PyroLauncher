<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PyroLauncher.Desktop"
             xmlns:i="clr-namespace:PyroLauncher.Desktop"
             xmlns:c="clr-namespace:PyroLauncher.Desktop.Controls"
             x:Class="PyroLauncher.Desktop.Views.ServerSettingsView">
    <ScrollViewer Padding="0,0,8,24">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Classes="h2" Text="{l:T 'General'}" Margin="0,0,0,4"/>
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,320">
                    <TextBlock Classes="rowTitle" Text="{l:T 'Name'}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Name}"/>
                </Grid>
            </Border>
            <Border Classes="settingRow">
                <StackPanel>
                    <TextBlock Classes="rowTitle" Text="{l:T 'Memory'}"/>
                    <TextBlock Classes="faint" Text="{l:T 'Maximum memory the server may use.'}" Margin="0,3,0,10"/>
                    <c:MemoryPicker Value="{Binding MemoryMb}"/>
                </StackPanel>
            </Border>
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,320">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Classes="rowTitle" Text="{l:T 'Java arguments'}"/>
                        <TextBlock Classes="faint" Text="{l:T 'Extra JVM flags, e.g. garbage collector tuning. Leave empty if unsure.'}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding JvmArgs}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,320">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Classes="rowTitle" Text="{l:T 'Java executable'}"/>
                        <TextBlock Classes="faint" Text="{l:T 'Leave empty to use the Java the launcher manages for this Minecraft version.'}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <DockPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button DockPanel.Dock="Right" Content="{l:T 'Browse…'}" Command="{Binding BrowseJavaCommand}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding JavaPath}" Watermark="{l:T 'Managed Java'}" ToolTip.Tip="{Binding JavaPath}"/>
                    </DockPanel>
                </Grid>
            </Border>
            <Border Classes="settingRow">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding ResetStartArgsCommand}" VerticalAlignment="Top"
                                ToolTip.Tip="{l:T 'Go back to the start command the installer detected'}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="icon" Text="{i:I E894}" FontSize="{l:F 13}"/><TextBlock Text="{l:T 'Reset'}"/></StackPanel>
                        </Button>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Classes="rowTitle" Text="{l:T 'Start command'}"/>
                            <TextBlock Classes="faint" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="{l:T 'What comes after Java and the memory flags: the server jar or loader arguments, and options like nogui. Quote parts that contain spaces.'}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBox Text="{Binding StartArgs}" FontFamily="{StaticResource MonoFont}" Margin="0,10,0,0" TextWrapping="Wrap" Watermark="-jar server.jar nogui"/>
                    <TextBlock Classes="overline" Text="{l:T 'FULL COMMAND'}" Margin="0,12,0,4"/>
                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <SelectableTextBlock Text="{Binding CommandPreview}" FontFamily="{StaticResource MonoFont}" FontSize="{l:F 13}" TextWrapping="Wrap" Foreground="{StaticResource Fg2}"/>
                    </Border>
                </StackPanel>
            </Border>
            <Button Classes="primary" Command="{Binding SaveCommand}" Content="{l:T 'Save'}" HorizontalAlignment="Left" Margin="0,12,0,0"/>

            <TextBlock Classes="h2" Text="{l:T 'Linked instances'}" Margin="0,28,0,4"/>
            <TextBlock Classes="faint" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="{l:T 'Linked instances get a button next to Play to start and stop this server.'}"/>
            <Border Classes="settingRow">
                <Grid>
                    <TextBlock Classes="faint" Text="{l:T 'No instances yet.'}" IsVisible="{Binding !Links.Count}"/>
                    <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsLinked}" Margin="0,3">
                                    <TextBlock><Run Text="{Binding Instance.Name}" FontWeight="SemiBold"/>  <Run Text="{Binding Instance.VersionText}" Foreground="{StaticResource Fg3}"/></TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <TextBlock Classes="h2" Text="{l:T 'Manage'}" Margin="0,28,0,4"/>
            <Border Classes="settingRow">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding OpenFolderCommand}" Content="{l:T 'Open folder'}"/>
                    <TextBlock Classes="rowTitle" Text="{l:T 'Server folder'}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Border Classes="settingRow">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding ReinstallCommand}" Content="{l:T 'Reinstall'}"/>
                    <StackPanel>
                        <TextBlock Classes="rowTitle" Text="{l:T 'Reinstall server files'}"/>
                        <TextBlock Classes="faint" Text="{l:T 'Downloads the server jar and mod loader again. Worlds, mods and configs are kept.'}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Classes="settingRow" BorderThickness="0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding DeleteCommand}" Content="{l:T 'Delete'}"/>
                    <StackPanel>
                        <TextBlock Classes="rowTitle" Text="{l:T 'Delete server pack'}"/>
                        <TextBlock Classes="faint" Text="{l:T 'Removes the server with its world. This can’t be undone.'}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
