<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PyroLauncher.Desktop"
             xmlns:i="clr-namespace:PyroLauncher.Desktop"
             xmlns:c="clr-namespace:PyroLauncher.Desktop.Controls"
             x:Class="PyroLauncher.Desktop.Views.ServerPacksView">
    <Grid Margin="36,0,36,0" RowDefinitions="Auto,*">
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Classes="primary" Command="{Binding CreateCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="{i:I E710}"/>
                    <TextBlock Text="{l:T 'New server pack'}"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Classes="h1" Text="{l:T 'Server packs'}"/>
                <TextBlock Classes="muted" Text="{l:T 'Run Minecraft servers made from your instances or a modpack’s server files.'}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,80" MaxWidth="480" IsVisible="{Binding IsEmpty}">
            <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Classes="icon" Text="{i:I E968}" FontSize="{l:F 28}" HorizontalAlignment="Center" Foreground="{StaticResource Fg2}"/>
            </Border>
            <TextBlock Classes="h2" Text="{l:T 'No server packs yet'}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
            <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                       Text="{l:T 'Create one from an instance (you choose which mods go on the server), or open a modpack and use Create server pack on its page.'}"/>
            <Button Classes="primary" Command="{Binding CreateCommand}" HorizontalAlignment="Center" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="{i:I E710}"/>
                    <TextBlock Text="{l:T 'New server pack'}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowGrid}">
            <ItemsControl ItemsSource="{Binding Packs}" Margin="0,0,6,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="instanceCard" Classes.active="{Binding IsRunning}" Width="236" Margin="0,0,14,14"
                                c:Tap.Command="{Binding $parent[UserControl].DataContext.OpenCommand}" c:Tap.Parameter="{Binding}">
                            <Grid RowDefinitions="120,Auto">
                                <Border CornerRadius="11,11,0,0" Background="{StaticResource Bg3}" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" FontSize="{l:F 52}" FontWeight="Bold" Foreground="#FF3A3A3A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Instance.Icon}" Stretch="UniformToFill" Opacity="0.35">
                                            <Image.Effect><BlurEffect Radius="28"/></Image.Effect>
                                        </Image>
                                        <Image Source="{Binding Instance.Icon}" Stretch="Uniform" Margin="12" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        <Border Classes="badge" Background="#E6000000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding IsRunning}"/>
                                                <TextBlock Classes="badgeText" Text="{Binding StateText}" Foreground="{StaticResource Fg}" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Classes="play" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                                Command="{Binding $parent[UserControl].DataContext.ToggleCommand}" CommandParameter="{Binding}"
                                                Content="{Binding ToggleGlyph, Converter={StaticResource Icon}}" ToolTip.Tip="{Binding ToggleTip}"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="14,12,14,13">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{l:F 15}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Classes="muted" Text="{Binding VersionText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding !IsBusy}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{l:T 'Players online'}">
                                                <TextBlock Classes="icon" Text="{i:I E77B}" FontSize="{l:F 12}" Foreground="{StaticResource Fg3}"/>
                                                <TextBlock Classes="faint" Text="{Binding PlayerCountText}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{l:T 'Memory'}">
                                                <TextBlock Classes="icon" Text="{i:I E7B8}" FontSize="{l:F 12}" Foreground="{StaticResource Fg3}"/>
                                                <TextBlock Classes="faint" Text="{Binding MemoryText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding IsBusy}">
                                            <TextBlock Classes="faint" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Margin="0,6,0,0" Maximum="100" Value="{Binding Progress, Converter={StaticResource Percent}}"
                                                         IsIndeterminate="{Binding Progress, Converter={StaticResource Indeterminate}}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowList}">
            <ItemsControl ItemsSource="{Binding Packs}" Margin="0,0,6,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="instanceCard" Classes.active="{Binding IsRunning}" Margin="0,0,0,10" Padding="12"
                                c:Tap.Command="{Binding $parent[UserControl].DataContext.OpenCommand}" c:Tap.Parameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Border Width="52" Height="52" CornerRadius="10" Background="{StaticResource Bg3}" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" FontSize="{l:F 22}" FontWeight="Bold" Foreground="#FF4A4A4A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Instance.Icon}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{l:F 15}" TextTrimming="CharacterEllipsis"/>
                                        <Border Classes="badge">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding IsRunning}"/>
                                                <TextBlock Classes="badgeText" Text="{Binding StateText}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Classes="muted" Text="{Binding VersionText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsBusy}"/>
                                    <StackPanel IsVisible="{Binding IsBusy}" Margin="0,4,0,0">
                                        <TextBlock Classes="faint" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Margin="0,6,0,0" Maximum="100" Value="{Binding Progress, Converter={StaticResource Percent}}"
                                                     IsIndeterminate="{Binding Progress, Converter={StaticResource Indeterminate}}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="22" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <StackPanel Spacing="2" ToolTip.Tip="{l:T 'Players online'}">
                                        <TextBlock Classes="overline" Text="{l:T 'PLAYERS'}"/>
                                        <TextBlock Text="{Binding PlayerCountText}" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="overline" Text="{l:T 'MEMORY'}"/>
                                        <TextBlock Text="{Binding MemoryText}" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="3" Classes="play" Classes.always="True" VerticalAlignment="Center"
                                        Command="{Binding $parent[UserControl].DataContext.ToggleCommand}" CommandParameter="{Binding}"
                                        Content="{Binding ToggleGlyph, Converter={StaticResource Icon}}" ToolTip.Tip="{Binding ToggleTip}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
