<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PyroLauncher.Desktop"
             xmlns:i="clr-namespace:PyroLauncher.Desktop"
             xmlns:d="clr-namespace:PyroLauncher.Desktop.Views.Demo"
             x:Class="PyroLauncher.Desktop.Views.Demo.DemoServers">
    <StackPanel Margin="36,0,28,0">
        <DockPanel Margin="0,0,0,22">
            <Button DockPanel.Dock="Right" Classes="primary" Content="{l:T 'New server pack'}" VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock Classes="h1" Text="{l:T 'Server packs'}"/>
                <TextBlock Classes="faint" Text="{l:T 'Download, configure and start servers for your modpacks.'}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <ItemsControl x:Name="Cards" ItemsSource="{x:Static d:DemoData.Servers}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="instanceCard" Width="250" Margin="0,0,14,14">
                        <Grid RowDefinitions="140,Auto">
                            <Border CornerRadius="11,11,0,0" Background="{Binding Tint}">
                                <Grid>
                                    <TextBlock Text="{Binding Initial}" FontSize="{l:F 52}" FontWeight="Bold" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Classes="badge" Background="#E6000000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding On}"/>
                                            <TextBlock Classes="badgeText" Text="{Binding Extra}" Foreground="{StaticResource Fg}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="14,12">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{l:F 15}"/>
                                <TextBlock Classes="muted" Text="{Binding Sub}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl x:Name="Rows" ItemsSource="{x:Static d:DemoData.Servers}" IsVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="card" Padding="12,10" Margin="0,0,0,8">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="9" Background="{Binding Tint}" Margin="0,0,14,0">
                                <TextBlock Text="{Binding Initial}" FontSize="{l:F 20}" FontWeight="Bold" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button DockPanel.Dock="Right" Classes="primary" Content="{l:T 'Start'}" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding On}"/>
                                <TextBlock Classes="muted" Text="{Binding Extra}"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Classes="faint" Text="{Binding Sub}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
