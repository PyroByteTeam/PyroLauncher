<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PyroLauncher.Desktop"
             xmlns:i="clr-namespace:PyroLauncher.Desktop"
             xmlns:d="clr-namespace:PyroLauncher.Desktop.Views.Demo"
             x:Class="PyroLauncher.Desktop.Views.Demo.DemoInstance">
    <StackPanel Margin="36,0,28,0">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18">
            <Border Width="84" Height="84" CornerRadius="14" Background="#FF3E7C4F">
                <TextBlock Text="V" FontSize="{l:F 38}" FontWeight="Bold" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="20,2,20,0" VerticalAlignment="Center">
                <TextBlock Classes="h1" Text="Vanilla+"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="6">
                    <Border Classes="badge"><TextBlock Classes="badgeText" Text="1.21.4"/></Border>
                    <Border Classes="badge"><TextBlock Classes="badgeText" Text="Fabric 0.16.14"/></Border>
                    <TextBlock Classes="muted" Text="12h 40m" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Classes="primary" Padding="26,12" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="icon" Text="{i:I E768}"/><TextBlock Text="{l:T 'Play'}"/></StackPanel>
            </Button>
        </Grid>

        <!-- Top navigation: tabs + content -->
        <StackPanel x:Name="Tabs">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="tab" Content="{l:T 'Mods'}" Tag="{i:I EA86}" IsChecked="True"/>
                    <RadioButton Classes="tab" Content="{l:T 'Resource Packs'}" Tag="{i:I E790}"/>
                    <RadioButton Classes="tab" Content="{l:T 'Shaders'}" Tag="{i:I E706}"/>
                    <RadioButton Classes="tab" Content="{l:T 'Screenshots'}" Tag="{i:I EB9F}"/>
                    <RadioButton Classes="tab" Content="{l:T 'Logs'}" Tag="{i:I E9D9}"/>
                    <RadioButton Classes="tab" Content="{l:T 'Settings'}" Tag="{i:I E713}"/>
                </StackPanel>
            </Border>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Classes="primary" Content="{l:T 'Add content'}"/>
                <Button DockPanel.Dock="Right" Content="{l:T 'Update all'}" Margin="0,0,8,0"/>
                <Border Classes="row" Width="240" Padding="10,7" HorizontalAlignment="Left" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="icon" Text="{i:I E721}" Foreground="{StaticResource Fg3}"/><TextBlock Classes="faint" Text="{l:T 'Search mods'}"/></StackPanel>
                </Border>
            </DockPanel>
            <ItemsControl x:Name="ModList" ItemsSource="{x:Static d:DemoData.Mods}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="row" Padding="12,8" Margin="0,0,0,6">
                            <DockPanel>
                                <ToggleSwitch DockPanel.Dock="Left" IsChecked="{Binding On}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8" Background="{Binding Tint}" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Classes="icon" Text="{i:I E74D}" Foreground="{StaticResource Fg3}" Margin="16,0,4,0"/>
                                <Border DockPanel.Dock="Right" Classes="badge"><TextBlock Classes="badgeText" Text="{Binding Extra}"/></Border>
                                <Border DockPanel.Dock="Right" Classes="badge" Margin="0,0,8,0" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" IsVisible="{Binding Highlight}">
                                    <TextBlock Classes="badgeText" Text="{l:T 'Update'}" Foreground="{StaticResource AccentFg}" FontWeight="SemiBold"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Classes="faint" Text="{Binding Sub}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="ModGrid" ItemsSource="{x:Static d:DemoData.Mods}" IsVisible="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Width="208" Padding="14" Margin="0,0,10,10">
                            <StackPanel>
                                <DockPanel>
                                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding On}" VerticalAlignment="Top"/>
                                    <Border Width="52" Height="52" CornerRadius="10" Background="{Binding Tint}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Initial}" FontSize="{l:F 22}" FontWeight="Bold" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Classes="faint" Text="{Binding Sub}"/>
                                <Border Classes="badge" HorizontalAlignment="Left" Margin="0,8,0,0"><TextBlock Classes="badgeText" Text="{Binding Extra}"/></Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Grid: overview of section cards -->
        <ItemsControl x:Name="Sections" ItemsSource="{x:Static d:DemoData.Sections}" IsVisible="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="card" Height="128" Padding="18" Margin="0,0,12,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Classes="faint" Text="{Binding Count}"/>
                            <TextBlock DockPanel.Dock="Bottom" Classes="h3" Text="{Binding Name}" FontSize="{l:F 16}" Margin="0,0,0,4"/>
                            <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource Bg3}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Classes="icon" Text="{Binding Glyph, Converter={StaticResource Icon}}" FontSize="{l:F 16}" HorizontalAlignment="Center"/>
                            </Border>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
