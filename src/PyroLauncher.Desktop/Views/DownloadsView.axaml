<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PyroLauncher.Desktop"
             xmlns:i="clr-namespace:PyroLauncher.Desktop"
             x:Class="PyroLauncher.Desktop.Views.DownloadsView">
    <Grid Margin="36,0,36,0" RowDefinitions="Auto,*">
        <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                <Button Content="{l:T 'Pause all'}" Command="{Binding PauseAllCommand}"/>
                <Button Content="{l:T 'Resume all'}" Command="{Binding ResumeAllCommand}"/>
                <Button Content="{l:T 'Cancel all'}" Command="{Binding CancelAllCommand}"/>
                <Button Content="{l:T 'Clear finished'}" Command="{Binding ClearFinishedCommand}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="h1" Text="{l:T 'Downloads'}"/>
                <TextBlock Classes="muted" Margin="0,4,0,0">
                    <Run Text="{Binding Summary.ActiveCount}"/><Run Text="{l:T ' active'}"/> <Run Text="{Binding Summary.Text}"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,24,360">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="overline" Text="{l:T 'TASKS'}" Margin="2,0,0,10"/>
                <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{l:T 'Nothing has been downloaded yet in this session.'}" IsVisible="{Binding !Jobs.Count}"/>
                <ScrollViewer Padding="0,0,8,20">
                    <ItemsControl ItemsSource="{Binding Jobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card" Padding="18,14" Margin="0,0,0,10" Opacity="{Binding IsActive, Converter={x:Static l:BoolToOpacity.Instance}}">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsActive}">
                                                <Button Content="{l:T 'Pause'}" Padding="12,5" IsVisible="{Binding !IsPaused}"
                                                        Command="{Binding $parent[UserControl].DataContext.PauseCommand}" CommandParameter="{Binding}"/>
                                                <Button Classes="primary" Content="{l:T 'Resume'}" Padding="12,5" IsVisible="{Binding IsPaused}"
                                                        Command="{Binding $parent[UserControl].DataContext.ResumeCommand}" CommandParameter="{Binding}"/>
                                                <Button Classes="ghost" Content="{l:T 'Cancel'}" Padding="12,5" IsVisible="{Binding CanCancel}"
                                                        Command="{Binding $parent[UserControl].DataContext.CancelCommand}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Classes="h3" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                <Border Classes="badge" Margin="10,0,0,0"><TextBlock Classes="badgeText" Text="{Binding StateText}"/></Border>
                                            </StackPanel>
                                        </DockPanel>
                                        <ProgressBar Margin="0,12,0,8" Maximum="100" Value="{Binding Progress, Converter={StaticResource Percent}}"
                                                     IsIndeterminate="{Binding Progress, Converter={StaticResource Indeterminate}}"/>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Classes="mono" Text="{Binding SpeedText}" FontSize="12"/>
                                            <TextBlock Classes="muted"><Run Text="{Binding FilesText}"/><Run Text="  ·  "/><Run Text="{Binding BytesText}"/></TextBlock>
                                        </DockPanel>
                                        <TextBlock Classes="faint mono" Text="{Binding CurrentFile}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding CurrentFile, Converter={StaticResource VisibleIf}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                    <Button DockPanel.Dock="Right" Classes="ghost" Content="{l:T 'Copy all'}" Padding="8,2" FontSize="12" Command="{Binding CopyAllHostsCommand}"/>
                    <Button DockPanel.Dock="Right" Classes="ghost" Content="{l:T 'Clear'}" Padding="8,2" FontSize="12" Margin="0,0,4,0"
                            Command="{Binding ClearHostsCommand}" ToolTip.Tip="{l:T 'Clear the list of contacted domains'}"/>
                    <TextBlock Classes="overline" Text="{l:T 'CONNECTED SERVERS'}" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Classes="card" Padding="0,6" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="16,6,16,8" ColumnDefinitions="*,64,76,30">
                            <TextBlock Classes="faint" Text="{l:T 'Domain'}"/>
                            <TextBlock Grid.Column="1" Classes="faint" Text="{l:T 'Active'}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Classes="faint" Text="{l:T 'Received'}" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Classes="muted" Text="{l:T 'No connections yet.'}" Margin="16,0,16,8" IsVisible="{Binding !Hosts.Count}"/>
                        <ItemsControl ItemsSource="{Binding Hosts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,5" ColumnDefinitions="*,64,76,30" Background="Transparent"
                                          ToolTip.Tip="{Binding Requests, Converter={StaticResource Format}, ConverterParameter='# requests'}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Opacity="{Binding Active, Converter={x:Static l:CountToOpacity.Instance}}"/>
                                            <TextBlock Classes="mono" Text="{Binding Host}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Active}" HorizontalAlignment="Right" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Classes="muted" Text="{Binding BytesText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Classes="icon" Width="24" Height="24" FontSize="12" Content="{i:I E8C8}" HorizontalAlignment="Right"
                                                ToolTip.Tip="{l:T 'Copy domain (e.g. to add it to a VPN or firewall rule)'}"
                                                Command="{Binding $parent[UserControl].DataContext.CopyHostCommand}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
