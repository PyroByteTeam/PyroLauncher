<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PyroLauncher.Desktop"
             x:Class="PyroLauncher.Desktop.Views.ChoiceDialogView">
    <Border Classes="dialog" Width="420">
        <StackPanel>
            <TextBlock Classes="h2" Text="{Binding Title}"/>
            <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,16"/>
            <ScrollViewer MaxHeight="340">
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="14,9"
                                    Command="{Binding $parent[UserControl].DataContext.ChooseCommand}" CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button Content="{l:T 'Cancel'}" Command="{Binding CancelCommand}" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True"/>
        </StackPanel>
    </Border>
</UserControl>
