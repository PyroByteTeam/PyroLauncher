<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PyroLauncher.Desktop"
             xmlns:i="clr-namespace:PyroLauncher.Desktop"
             xmlns:c="clr-namespace:PyroLauncher.Desktop.Controls"
             x:Class="PyroLauncher.Desktop.Views.SettingsView">
    <UserControl.Styles>
        <Style Selector="TextBlock.rowTitle"><Setter Property="FontWeight" Value="SemiBold"/></Style>
        
        <!-- Layout preview mockups (shown when hovering the layout options) -->
        <Style Selector="Border.mockFrame">
            <Setter Property="Width" Value="236"/><Setter Property="Height" Value="150"/><Setter Property="Background" Value="#FF101010"/>
            <Setter Property="BorderBrush" Value="#FF2E2E2E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10"/>
        </Style>
        <Style Selector="Border.mockBar"><Setter Property="Background" Value="#FF3C3C3C"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Height" Value="6"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
        <Style Selector="Border.mockBar.hi"><Setter Property="Background" Value="#FFE8E8E8"/></Style>
        <Style Selector="Border.mockCard"><Setter Property="Background" Value="#FF1C1C1C"/><Setter Property="BorderBrush" Value="#FF2E2E2E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Margin" Value="0,0,5,5"/></Style>
        <Style Selector="RadioButton.preview">
            <Setter Property="ToolTip.Placement" Value="Right"/>
            <Setter Property="ToolTip.ShowDelay" Value="150"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="36,0,20,0" RowDefinitions="Auto,Auto,*">
        <StackPanel Margin="0,0,0,18">
            <TextBlock Classes="h1" Text="{l:T 'Settings'}"/>
            <TextBlock Classes="muted" Text="{l:T 'Changes are saved automatically.'}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,0,16,18">
            <StackPanel Orientation="Horizontal">
                <RadioButton Classes="tab" Content="{l:T 'Launcher'}" Tag="{i:I E8B7}" GroupName="stab" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=launcher}"/>
                <RadioButton Classes="tab" Content="{l:T 'Appearance'}" Tag="{i:I E1C1}" GroupName="stab" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=appearance}"/>
                <RadioButton Classes="tab" Content="{l:T 'Themes'}" Tag="{i:I E790}" GroupName="stab" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=themes}"/>
                <RadioButton Classes="tab" Content="{l:T 'Minecraft (all instances)'}" Tag="{i:I E7FC}" GroupName="stab" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=minecraft}"/>
                <RadioButton Classes="tab" Content="{l:T 'About'}" Tag="{i:I E946}" GroupName="stab" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=about}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2">
            <!-- Up to 820px wide, narrower in small windows (never cropped), always left-aligned.
                 The spacing is a Margin on the content: ScrollViewer Padding is not part of the scrollable extent. -->
            <Grid Margin="0,0,16,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="820"/></Grid.ColumnDefinitions>
                <StackPanel Classes="section" IsVisible="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=launcher}">
                    <TextBlock Classes="h2" Text="{l:T 'Services'}" Margin="0,0,0,4"/>
                    <Border Classes="settingRow">
                        <StackPanel>
                            <TextBlock Classes="rowTitle" Text="{l:T 'CurseForge API key'}"/>
                            <WrapPanel Margin="0,3,0,8">
                                <TextBlock Classes="faint" Text="{l:T 'Enables CurseForge search, mod pages and CurseForge modpack import. Get a free key from the'}" TextWrapping="Wrap"/>
                                <Button Classes="ghost" Content="CurseForge console" Padding="4,0" FontSize="{l:F 13}" Foreground="{StaticResource Fg}"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="https://console.curseforge.com/"/>
                            </WrapPanel>
                            <TextBox Classes="mono" Text="{Binding CurseForgeApiKey}" Watermark="$2a$10$…" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,120">
                            <StackPanel>
                                <TextBlock Classes="rowTitle" Text="{l:T 'Parallel downloads'}"/>
                                <TextBlock Classes="faint" Text="{l:T 'How many files are downloaded at once (1-64).'}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding ConcurrentDownloads}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Classes="h2" Text="{l:T 'Java runtimes'}" Margin="0,28,0,2"/>
                    <TextBlock Classes="muted" Text="{l:T 'Eclipse Temurin builds from Adoptium, downloaded automatically when an instance needs them.'}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding JavaRuntimes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="icon" Content="{i:I E74D}" FontSize="{l:F 14}" ToolTip.Tip="{l:T 'Remove'}"
                                                Command="{Binding $parent[UserControl].DataContext.RemoveJavaCommand}" CommandParameter="{Binding}"/>
                                        <Button DockPanel.Dock="Right" Classes="icon" Content="{i:I E838}" FontSize="{l:F 14}" ToolTip.Tip="{l:T 'Open folder'}"
                                                Command="{Binding $parent[UserControl].DataContext.OpenJavaFolderCommand}" CommandParameter="{Binding}"/>
                                        <Border Classes="badge" Margin="0,0,12,0"><TextBlock Classes="badgeText" Text="{Binding Major, StringFormat='Java {0}'}" Foreground="{StaticResource Fg}"/></Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Classes="faint" Text="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Spacing="6" IsEnabled="{Binding !InstallingJava}">
                        <TextBlock Classes="muted" Text="{l:T 'Install:'}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button Content="Java 8" Command="{Binding InstallJavaCommand}" CommandParameter="8"/>
                        <Button Content="Java 17" Command="{Binding InstallJavaCommand}" CommandParameter="17"/>
                        <Button Content="Java 21" Command="{Binding InstallJavaCommand}" CommandParameter="21"/>
                        <Button Content="Java 25" Command="{Binding InstallJavaCommand}" CommandParameter="25"/>
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0" IsVisible="{Binding InstallingJava}">
                        <TextBlock Classes="muted" Text="{Binding JavaStatus}"/>
                        <ProgressBar IsIndeterminate="True" Margin="0,6,0,0"/>
                    </StackPanel>

                    <TextBlock Classes="h2" Text="{l:T 'Advanced'}" Margin="0,28,0,4"/>
                    <Border Classes="settingRow">
                        <DockPanel>
                            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding DeveloperMode}" VerticalAlignment="Center"/>
                            <TextBlock Classes="rowTitle" Text="{l:T 'Developer mode'}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border Classes="settingRow" BorderThickness="0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:T 'Open folder'}" Command="{Binding OpenDataFolderCommand}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Classes="rowTitle" Text="{l:T 'Launcher data'}"/>
                                <TextBlock Classes="faint" Text="{Binding DataFolder}" Margin="0,3,12,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DataFolder}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel Classes="section" IsVisible="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=themes}">
                    <StackPanel DataContext="{Binding Themes}">
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                <Button Classes="primary" Command="{Binding CreateCommand}" ToolTip.Tip="{l:T 'Create a new theme from the current one'}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Classes="icon" Text="{i:I E710}" FontSize="{l:F 13}"/>
                                        <TextBlock Text="{l:T 'New theme'}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ImportCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Classes="icon" Text="{i:I E8B5}" FontSize="{l:F 13}"/>
                                        <TextBlock Text="{l:T 'Import'}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Classes="icon" Text="{i:I EDE1}" FontSize="{l:F 13}"/>
                                        <TextBlock Text="{l:T 'Export'}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="h2" Text="{l:T 'Theme'}"/>
                                <TextBlock Classes="faint" Text="{l:T 'Click a theme to switch to it. Built-in themes can be copied and then customised.'}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Themes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="themeCard" Classes.active="{Binding IsActive}" Margin="0,0,10,10" Padding="0" Width="152"
                                            Command="{Binding $parent[ItemsControl].DataContext.SwitchCommand}" CommandParameter="{Binding}">
                                        <StackPanel>
                                            <Border Height="64" CornerRadius="7,7,0,0" ClipToBounds="True" Background="{Binding SwatchBg, Converter={StaticResource HexColor}}">
                                                <Grid Margin="10">
                                                    <Border Background="{Binding SwatchCard, Converter={StaticResource HexColor}}" CornerRadius="5" Width="70" HorizontalAlignment="Left">
                                                        <StackPanel Margin="7" Spacing="5">
                                                            <Border Height="5" Width="44" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding SwatchText, Converter={StaticResource HexColor}}"/>
                                                            <Border Height="5" Width="30" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding SwatchText, Converter={StaticResource HexColor}}" Opacity="0.5"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Ellipse Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{Binding SwatchAccent, Converter={StaticResource HexColor}}"/>
                                                </Grid>
                                            </Border>
                                            <DockPanel Margin="10,8">
                                                <TextBlock DockPanel.Dock="Right" Classes="faint" Text="{l:T 'Built-in'}" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding IsBuiltIn}"/>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Editor for the active theme -->
                        <Border Classes="card" Padding="20,6,20,16" Margin="0,4,0,0">
                            <StackPanel>
                                <Border Classes="settingRow">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsEditable}">
                                            <Button Classes="icon" Content="{i:I E70F}" ToolTip.Tip="{l:T 'Rename'}" Command="{Binding RenameCommand}"/>
                                            <Button Classes="icon" Content="{i:I E894}" ToolTip.Tip="{l:T 'Reset colors and sizes'}" Command="{Binding ResetColorsCommand}"/>
                                            <Button Classes="icon" Content="{i:I E74D}" ToolTip.Tip="{l:T 'Delete theme'}" Command="{Binding DeleteCommand}"/>
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right" Content="{l:T 'Customize a copy'}" Command="{Binding CreateCommand}" VerticalAlignment="Center" IsVisible="{Binding IsBuiltIn}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="h3" Text="{Binding Theme.Name}"/>
                                            <TextBlock Classes="faint" Text="{l:T 'Built-in themes can not be changed. Customize a copy to edit colors, font size and background.'}"
                                                       TextWrapping="Wrap" Margin="0,3,16,0" IsVisible="{Binding IsBuiltIn}"/>
                                            <TextBlock Classes="faint" Text="{l:T 'Changes apply right away and are saved to this theme.'}" Margin="0,3,0,0" IsVisible="{Binding IsEditable}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <StackPanel IsEnabled="{Binding IsEditable}">
                                    <Border Classes="settingRow">
                                        <Grid ColumnDefinitions="*,300,56">
                                            <StackPanel>
                                                <TextBlock Classes="rowTitle" Text="{l:T 'Font size'}"/>
                                                <TextBlock Classes="faint" Text="{l:T 'Scales all text in the launcher.'}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Slider Grid.Column="1" Minimum="80" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding FontPercent}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding FontPercentText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Classes="settingRow">
                                        <Grid ColumnDefinitions="*,300,56">
                                            <StackPanel>
                                                <TextBlock Classes="rowTitle" Text="{l:T 'Side menu size'}"/>
                                                <TextBlock Classes="faint" Text="{l:T 'The page selector on the left: icons, labels and width.'}" Margin="0,3,16,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Slider Grid.Column="1" Minimum="80" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SidebarPercent}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SidebarPercentText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Classes="settingRow">
                                        <Grid ColumnDefinitions="*,300,56">
                                            <StackPanel>
                                                <TextBlock Classes="rowTitle" Text="{l:T 'Top menu size'}"/>
                                                <TextBlock Classes="faint" Text="{l:T 'The tabs at the top of instance, server pack and settings pages.'}" Margin="0,3,16,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Slider Grid.Column="1" Minimum="80" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding TopMenuPercent}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TopMenuPercentText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Classes="settingRow">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Content="{l:T 'Choose image…'}" Command="{Binding ChooseBackgroundCommand}"/>
                                                <Button Content="{l:T 'Remove'}" Command="{Binding RemoveBackgroundCommand}" IsVisible="{Binding HasBackground}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Classes="rowTitle" Text="{l:T 'Background image'}"/>
                                                <TextBlock Classes="faint" Text="{l:T 'Shown behind the whole window. PNG, JPEG, WebP, BMP or GIF.'}" Margin="0,3,16,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Classes="settingRow">
                                        <Grid ColumnDefinitions="*,300,56">
                                            <StackPanel>
                                                <TextBlock Classes="rowTitle" Text="{l:T 'Background transparency'}"/>
                                                <TextBlock Classes="faint" Text="{l:T 'How much of the background image shows through. Without an image, the desktop shows through (blurred where supported).'}"
                                                           Margin="0,3,16,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="95" Value="{Binding TransparencyPercent}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TransparencyText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Classes="rowTitle" Text="{l:T 'Colors'}" Margin="0,14,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Colors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="row" Padding="12,6" Margin="0,0,8,8">
                                                    <DockPanel>
                                                        <ColorPicker DockPanel.Dock="Right" IsAlphaEnabled="False" IsAlphaVisible="False"
                                                                     Color="{Binding Hex, Converter={StaticResource HexColor}, Mode=TwoWay}"/>
                                                        <TextBlock Classes="mono faint" DockPanel.Dock="Right" Text="{Binding Hex}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Classes="section" IsVisible="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=appearance}">
                    <TextBlock Classes="h2" Text="{l:T 'Language'}" Margin="0,0,0,4"/>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,320">
                            <StackPanel>
                                <TextBlock Classes="rowTitle" Text="{l:T 'Launcher language'}"/>
                                <TextBlock Classes="faint" Text="{l:T 'Automatic follows the system language.'}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Classes="h2" Text="{l:T 'Layout'}" Margin="0,28,0,4"/>
                    <Border Classes="settingRow">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                <RadioButton Classes="segment preview" Content="{l:T 'Top navigation'}" GroupName="menu"
                                             IsChecked="{Binding InstanceMenuStyle, Converter={StaticResource Eq}, ConverterParameter=TopNavigation}">
                                    <ToolTip.Tip>
                                        <StackPanel>
                                            <TextBlock Text="{l:T 'Top navigation'}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <Border Classes="mockFrame">
                                                <StackPanel>
                                                    <Border Classes="mockBar hi" Width="90" Height="8"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Spacing="8">
                                                        <Border Classes="mockBar hi" Width="24"/><Border Classes="mockBar" Width="34"/><Border Classes="mockBar" Width="24"/><Border Classes="mockBar" Width="30"/>
                                                    </StackPanel>
                                                    <Border Height="1" Background="#FF2E2E2E" Margin="0,6,0,8"/>
                                                    <Border Classes="mockCard" Height="16" Margin="0,0,0,5"/><Border Classes="mockCard" Height="16" Margin="0,0,0,5"/><Border Classes="mockCard" Height="16" Margin="0,0,0,5"/><Border Classes="mockCard" Height="16" Margin="0"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Classes="faint" Text="{l:T 'Sections are tabs across the top of the instance page.'}" Margin="0,6,0,0" Width="236" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </RadioButton>
                                <RadioButton Classes="segment preview" Content="{l:T 'Grid'}" GroupName="menu"
                                             IsChecked="{Binding InstanceMenuStyle, Converter={StaticResource Eq}, ConverterParameter=Grid}">
                                    <ToolTip.Tip>
                                        <StackPanel>
                                            <TextBlock Text="{l:T 'Grid'}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <Border Classes="mockFrame">
                                                <StackPanel>
                                                    <Border Classes="mockBar hi" Width="90" Height="8" Margin="0,0,0,10"/>
                                                    <UniformGrid Columns="3" Rows="2" Height="104">
                                                        <Border Classes="mockCard"><Border Classes="mockBar hi" Width="30" Margin="5" VerticalAlignment="Top"/></Border>
                                                        <Border Classes="mockCard"><Border Classes="mockBar hi" Width="36" Margin="5" VerticalAlignment="Top"/></Border>
                                                        <Border Classes="mockCard"><Border Classes="mockBar hi" Width="26" Margin="5" VerticalAlignment="Top"/></Border>
                                                        <Border Classes="mockCard"><Border Classes="mockBar hi" Width="32" Margin="5" VerticalAlignment="Top"/></Border>
                                                        <Border Classes="mockCard"><Border Classes="mockBar hi" Width="24" Margin="5" VerticalAlignment="Top"/></Border>
                                                        <Border Classes="mockCard"><Border Classes="mockBar hi" Width="28" Margin="5" VerticalAlignment="Top"/></Border>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Classes="faint" Text="{l:T 'An overview of section cards; drag them to rearrange.'}" Margin="0,6,0,0" Width="236" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </RadioButton>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="rowTitle" Text="{l:T 'Instance menu'}"/>
                                <TextBlock Classes="faint" Text="{l:T 'Tabs across the top, or an overview grid of section cards you can drag to rearrange.'}" Margin="0,3,16,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Classes="settingRow">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                <RadioButton Classes="segment preview" Content="{l:T 'List'}" GroupName="list" IsChecked="{Binding ContentListStyle, Converter={StaticResource Eq}, ConverterParameter=List}">
                                    <ToolTip.Tip>
                                        <StackPanel>
                                            <TextBlock Text="{l:T 'List'}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <Border Classes="mockFrame">
                                                <StackPanel Spacing="6">
                                                    <Border Classes="mockCard" Height="22" Margin="0"><StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center" Spacing="6"><Border Width="12" Height="7" CornerRadius="3.5" Background="#FFE8E8E8"/><Border Width="12" Height="12" CornerRadius="2" Background="#FF6A6A6A"/><Border Classes="mockBar" Width="80"/></StackPanel></Border>
                                                    <Border Classes="mockCard" Height="22" Margin="0"><StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center" Spacing="6"><Border Width="12" Height="7" CornerRadius="3.5" Background="#FFE8E8E8"/><Border Width="12" Height="12" CornerRadius="2" Background="#FF6A6A6A"/><Border Classes="mockBar" Width="110"/></StackPanel></Border>
                                                    <Border Classes="mockCard" Height="22" Margin="0"><StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center" Spacing="6"><Border Width="12" Height="7" CornerRadius="3.5" Background="#FF3C3C3C"/><Border Width="12" Height="12" CornerRadius="2" Background="#FF6A6A6A"/><Border Classes="mockBar" Width="64"/></StackPanel></Border>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Classes="faint" Text="{l:T 'Detailed rows with switch, name, version and source.'}" Margin="0,6,0,0" Width="236" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </RadioButton>
                                <RadioButton Classes="segment preview" Content="{l:T 'Grid'}" GroupName="list" IsChecked="{Binding ContentListStyle, Converter={StaticResource Eq}, ConverterParameter=Grid}">
                                    <ToolTip.Tip>
                                        <StackPanel>
                                            <TextBlock Text="{l:T 'Grid'}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <Border Classes="mockFrame">
                                                <UniformGrid Columns="6" Rows="3">
                                                    <Border Classes="mockCard"/><Border Classes="mockCard"/><Border Classes="mockCard"/><Border Classes="mockCard"/><Border Classes="mockCard"/><Border Classes="mockCard"/>
                                                    <Border Classes="mockCard"/><Border Classes="mockCard"/><Border Classes="mockCard"/><Border Classes="mockCard"/><Border Classes="mockCard"/><Border Classes="mockCard"/>
                                                    <Border Classes="mockCard"/><Border Classes="mockCard"/>
                                                </UniformGrid>
                                            </Border>
                                            <TextBlock Classes="faint" Margin="0,6,0,0" Width="236" TextWrapping="Wrap">
                                                <TextBlock.Text><l:T Key="Compact icon tiles (or two letters when there's no icon)."/></TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </RadioButton>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="rowTitle" Text="{l:T 'Mod list style'}"/>
                                <TextBlock Classes="faint" Text="{l:T 'How mods, resource packs and shader packs are listed: detailed rows or a grid of icons.'}" Margin="0,3,16,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Classes="settingRow">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                <RadioButton Classes="segment preview" Content="{l:T 'List'}" GroupName="discover" IsChecked="{Binding DiscoverStyle, Converter={StaticResource Eq}, ConverterParameter=List}">
                                    <ToolTip.Tip>
                                        <StackPanel>
                                            <TextBlock Text="{l:T 'List'}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <Border Classes="mockFrame">
                                                <StackPanel Spacing="6">
                                                    <Border Classes="mockCard" Height="38" Margin="0"><StackPanel Orientation="Horizontal" Margin="5" Spacing="7"><Border Width="26" Height="26" CornerRadius="4" Background="#FF6A6A6A"/><StackPanel Spacing="5"><Border Classes="mockBar hi" Width="70"/><Border Classes="mockBar" Width="100" Height="4"/></StackPanel></StackPanel></Border>
                                                    <Border Classes="mockCard" Height="38" Margin="0"><StackPanel Orientation="Horizontal" Margin="5" Spacing="7"><Border Width="26" Height="26" CornerRadius="4" Background="#FF8A8A8A"/><StackPanel Spacing="5"><Border Classes="mockBar hi" Width="54"/><Border Classes="mockBar" Width="88" Height="4"/></StackPanel></StackPanel></Border>
                                                    <Border Classes="mockCard" Height="38" Margin="0"><StackPanel Orientation="Horizontal" Margin="5" Spacing="7"><Border Width="26" Height="26" CornerRadius="4" Background="#FF5A5A5A"/><StackPanel Spacing="5"><Border Classes="mockBar hi" Width="80"/><Border Classes="mockBar" Width="94" Height="4"/></StackPanel></StackPanel></Border>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Classes="faint" Text="{l:T 'Icon, description and download, update and release info in wide rows.'}" Margin="0,6,0,0" Width="236" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </RadioButton>
                                <RadioButton Classes="segment preview" Content="{l:T 'Grid'}" GroupName="discover" IsChecked="{Binding DiscoverStyle, Converter={StaticResource Eq}, ConverterParameter=Grid}">
                                    <ToolTip.Tip>
                                        <StackPanel>
                                            <TextBlock Text="{l:T 'Grid'}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <Border Classes="mockFrame">
                                                <UniformGrid Columns="3" Rows="2">
                                                    <Border Classes="mockCard"><StackPanel><Border Height="26" CornerRadius="3,3,0,0" Background="#FF4A4A4A"/><Border Classes="mockBar hi" Width="34" Margin="4,5,0,3"/></StackPanel></Border>
                                                    <Border Classes="mockCard"><StackPanel><Border Height="26" CornerRadius="3,3,0,0" Background="#FF5E5E5E"/><Border Classes="mockBar hi" Width="28" Margin="4,5,0,3"/></StackPanel></Border>
                                                    <Border Classes="mockCard"><StackPanel><Border Height="26" CornerRadius="3,3,0,0" Background="#FF3E3E3E"/><Border Classes="mockBar hi" Width="38" Margin="4,5,0,3"/></StackPanel></Border>
                                                    <Border Classes="mockCard"><StackPanel><Border Height="26" CornerRadius="3,3,0,0" Background="#FF565656"/><Border Classes="mockBar hi" Width="30" Margin="4,5,0,3"/></StackPanel></Border>
                                                    <Border Classes="mockCard"><StackPanel><Border Height="26" CornerRadius="3,3,0,0" Background="#FF464646"/><Border Classes="mockBar hi" Width="36" Margin="4,5,0,3"/></StackPanel></Border>
                                                    <Border Classes="mockCard"><StackPanel><Border Height="26" CornerRadius="3,3,0,0" Background="#FF626262"/><Border Classes="mockBar hi" Width="26" Margin="4,5,0,3"/></StackPanel></Border>
                                                </UniformGrid>
                                            </Border>
                                            <TextBlock Classes="faint" Text="{l:T 'Cards with the pack picture, name and stats.'}" Margin="0,6,0,0" Width="236" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </RadioButton>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="rowTitle" Text="{l:T 'Discover layout'}"/>
                                <TextBlock Classes="faint" Text="{l:T 'How modpacks are shown on the Discover page: wide rows with details, or cards with a picture.'}" Margin="0,3,16,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Classes="settingRow">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                <RadioButton Classes="segment preview" Content="{l:T 'List'}" GroupName="servers" IsChecked="{Binding ServerListStyle, Converter={StaticResource Eq}, ConverterParameter=List}">
                                    <ToolTip.Tip>
                                        <StackPanel>
                                            <TextBlock Text="{l:T 'List'}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <Border Classes="mockFrame">
                                                <StackPanel Spacing="6">
                                                    <Border Classes="mockCard" Height="38" Margin="0"><StackPanel Orientation="Horizontal" Margin="5" Spacing="7"><Border Width="26" Height="26" CornerRadius="4" Background="#FF6A6A6A"/><StackPanel Spacing="5"><Border Classes="mockBar hi" Width="70"/><Border Classes="mockBar" Width="100" Height="4"/></StackPanel></StackPanel></Border>
                                                    <Border Classes="mockCard" Height="38" Margin="0"><StackPanel Orientation="Horizontal" Margin="5" Spacing="7"><Border Width="26" Height="26" CornerRadius="4" Background="#FF8A8A8A"/><StackPanel Spacing="5"><Border Classes="mockBar hi" Width="54"/><Border Classes="mockBar" Width="88" Height="4"/></StackPanel></StackPanel></Border>
                                                    <Border Classes="mockCard" Height="38" Margin="0"><StackPanel Orientation="Horizontal" Margin="5" Spacing="7"><Border Width="26" Height="26" CornerRadius="4" Background="#FF5A5A5A"/><StackPanel Spacing="5"><Border Classes="mockBar hi" Width="80"/><Border Classes="mockBar" Width="94" Height="4"/></StackPanel></StackPanel></Border>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Classes="faint" Text="{l:T 'Compact rows with state, players and memory.'}" Margin="0,6,0,0" Width="236" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </RadioButton>
                                <RadioButton Classes="segment preview" Content="{l:T 'Grid'}" GroupName="servers" IsChecked="{Binding ServerListStyle, Converter={StaticResource Eq}, ConverterParameter=Grid}">
                                    <ToolTip.Tip>
                                        <StackPanel>
                                            <TextBlock Text="{l:T 'Grid'}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <Border Classes="mockFrame">
                                                <UniformGrid Columns="3" Rows="2">
                                                    <Border Classes="mockCard"><StackPanel><Border Height="26" CornerRadius="3,3,0,0" Background="#FF4A4A4A"/><Border Classes="mockBar hi" Width="34" Margin="4,5,0,3"/></StackPanel></Border>
                                                    <Border Classes="mockCard"><StackPanel><Border Height="26" CornerRadius="3,3,0,0" Background="#FF5E5E5E"/><Border Classes="mockBar hi" Width="28" Margin="4,5,0,3"/></StackPanel></Border>
                                                    <Border Classes="mockCard"><StackPanel><Border Height="26" CornerRadius="3,3,0,0" Background="#FF3E3E3E"/><Border Classes="mockBar hi" Width="38" Margin="4,5,0,3"/></StackPanel></Border>
                                                    <Border Classes="mockCard"><StackPanel><Border Height="26" CornerRadius="3,3,0,0" Background="#FF565656"/><Border Classes="mockBar hi" Width="30" Margin="4,5,0,3"/></StackPanel></Border>
                                                    <Border Classes="mockCard"><StackPanel><Border Height="26" CornerRadius="3,3,0,0" Background="#FF464646"/><Border Classes="mockBar hi" Width="36" Margin="4,5,0,3"/></StackPanel></Border>
                                                    <Border Classes="mockCard"><StackPanel><Border Height="26" CornerRadius="3,3,0,0" Background="#FF626262"/><Border Classes="mockBar hi" Width="26" Margin="4,5,0,3"/></StackPanel></Border>
                                                </UniformGrid>
                                            </Border>
                                            <TextBlock Classes="faint" Text="{l:T 'Cards with the server picture, state and players.'}" Margin="0,6,0,0" Width="236" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </RadioButton>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="rowTitle" Text="{l:T 'Server list layout'}"/>
                                <TextBlock Classes="faint" Text="{l:T 'How server packs are shown on the Servers page: cards with a picture, or compact rows.'}" Margin="0,3,16,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Classes="h2" Text="{l:T 'Behaviour'}" Margin="0,28,0,4"/>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,320">
                            <StackPanel>
                                <TextBlock Classes="rowTitle" Text="{l:T 'When the game starts'}"/>
                                <TextBlock Classes="faint" Text="{l:T 'The launcher keeps tracking play time in every mode.'}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LaunchOptions}" SelectedItem="{Binding OnLaunch}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <DockPanel>
                            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartFullscreen}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Classes="rowTitle" Text="{l:T 'Open the launcher in fullscreen'}"/>
                                <TextBlock Classes="faint" Text="{l:T 'Takes effect the next time the launcher starts. Press F11 to switch fullscreen at any time.'}" TextWrapping="Wrap" Margin="0,3,16,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Classes="settingRow" BorderThickness="0">
                        <DockPanel>
                            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding OpenConsoleOnLaunch}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Classes="rowTitle" Text="{l:T 'Separate game console window'}"/>
                                <TextBlock Classes="faint" TextWrapping="Wrap" Margin="0,3,16,0">
                                    <TextBlock.Text><l:T Key="Opens a live log window when a game starts or crashes. When off, logs are only shown on the instance's Logs page."/></TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel Classes="section" IsVisible="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=minecraft}">
                    <TextBlock Classes="muted" Text="{l:T 'These defaults apply to every instance unless the instance overrides them in its own Settings tab.'}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Border Classes="settingRow">
                        <StackPanel>
                            <TextBlock Classes="rowTitle" Text="{l:T 'Maximum memory'}"/>
                            <TextBlock Classes="faint" Text="{Binding SystemMemory}" Margin="0,3,0,10"/>
                            <c:MemoryPicker Value="{Binding MaxMemory}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="settingRow">
                        <StackPanel>
                            <TextBlock Classes="rowTitle" Text="{l:T 'Minimum memory'}"/>
                            <TextBlock Classes="faint" Text="{l:T 'Memory reserved at start-up. Usually far below the maximum.'}" Margin="0,3,0,10"/>
                            <c:MemoryPicker Value="{Binding MinMemory}"/>
                            <TextBlock Text="{l:T '⚠  The minimum is higher than the maximum. The launcher will use the maximum for both when starting the game.'}" Foreground="{StaticResource LogWarn}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding MinAboveMax}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="settingRow">
                        <StackPanel>
                            <TextBlock Classes="rowTitle" Text="{l:T 'Java executable'}"/>
                            <TextBlock Classes="faint" Text="{l:T 'Leave empty to pick the right Java version automatically (recommended).'}" Margin="0,3,0,8"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:T 'Browse…'}" Command="{Binding BrowseJavaCommand}" Margin="8,0,0,0"/>
                                <TextBox Text="{Binding JavaPath}" Watermark="{l:T 'Automatic (Adoptium)'}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Classes="settingRow">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Classes="ghost" Content="{l:T 'Reset'}" Command="{Binding ResetJvmArgsCommand}"/>
                                <StackPanel>
                                    <TextBlock Classes="rowTitle" Text="{l:T 'JVM arguments'}"/>
                                    <TextBlock Classes="faint" Text="{l:T 'Extra flags passed to Java (memory flags are added separately).'}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBox Margin="0,8,0,0" Text="{Binding JvmArgs}" FontFamily="{StaticResource MonoFont}" FontSize="{l:F 13}" TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="settingRow">
                        <StackPanel>
                            <TextBlock Classes="rowTitle" Text="{l:T 'Window size'}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox Width="100" Text="{Binding Width, Converter={StaticResource NullableInt}}"/>
                                <TextBlock Classes="muted" Text="×" VerticalAlignment="Center" Margin="10,0"/>
                                <TextBox Width="100" Text="{Binding Height, Converter={StaticResource NullableInt}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Classes="settingRow" BorderThickness="0">
                        <DockPanel>
                            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Fullscreen}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Classes="rowTitle" Text="{l:T 'Start in fullscreen'}"/>
                                <TextBlock Classes="faint" Text="{l:T 'Passes --fullscreen to the game.'}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Classes="h2" Text="{l:T 'Server packs'}" Margin="0,28,0,4"/>
                    <Border Classes="settingRow" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Classes="rowTitle" Text="{l:T 'Default server.properties'}"/>
                            <TextBlock Classes="faint" TextWrapping="Wrap" Margin="0,3,0,10"
                                       Text="{l:T 'Applied to every new server pack, one key=value per line. For example: online-mode=false, allow-flight=true, max-players=10.'}"/>
                            <TextBox Text="{Binding ServerPropertiesDefaults}" AcceptsReturn="True" Height="110" VerticalContentAlignment="Top"
                                     FontFamily="{StaticResource MonoFont}" Watermark="allow-flight=true"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Classes="section" IsVisible="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=about}">
                    <Border Classes="card" Padding="24,22">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="88" Height="88" CornerRadius="20" ClipToBounds="True" Margin="0,0,22,0" VerticalAlignment="Top">
                                <Image Source="avares://PyroLauncher/Assets/logo.png" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="h1" Text="PyroLauncher"/>
                                <TextBlock Margin="0,6,0,0" FontSize="{l:F 15}"><Run Text="{l:T 'Version'}" Foreground="{StaticResource Fg2}"/> <Run Text="{Binding AppVersion}" FontWeight="SemiBold"/></TextBlock>
                                <TextBlock Text="{l:T 'Made by the PyroByte team.'}" Foreground="{StaticResource Fg2}" Margin="0,4,0,0"/>
                                <TextBlock Classes="faint" Text="{l:T 'A Minecraft launcher for modded instances: Modrinth and CurseForge content, modpacks, presets and managed Java.'}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Classes="primary" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding !IsCheckingUpdates}" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="icon" Text="{i:I E777}"/><TextBlock Text="{l:T 'Check for updates'}"/></StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/PyroByteTeam/PyroLauncher" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="icon" Text="{i:I E8A7}"/><TextBlock Text="{l:T 'Source code'}"/></StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/PyroByteTeam/PyroLauncher/issues" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="icon" Text="{i:I EBE8}"/><TextBlock Text="{l:T 'Report a problem'}"/></StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="icon" Text="{i:I E838}"/><TextBlock Text="{l:T 'Open data folder'}"/></StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Classes="faint" Text="{Binding UpdateStatus}" IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Classes="h2" Text="{l:T 'Details'}" Margin="0,28,0,4"/>
                    <Border Classes="settingRow">
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding RuntimeText}" Foreground="{StaticResource Fg2}"/><TextBlock Classes="rowTitle" Text="{l:T 'Runtime'}"/></DockPanel>
                    </Border>
                    <Border Classes="settingRow">
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DataFolder}" Foreground="{StaticResource Fg2}" TextTrimming="CharacterEllipsis" MaxWidth="520"/><TextBlock Classes="rowTitle" Text="{l:T 'Data folder'}"/></DockPanel>
                    </Border>
                    <Border Classes="settingRow" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Classes="rowTitle" Text="{l:T 'Thanks to'}"/>
                            <TextBlock Classes="faint" Text="{l:T 'Modrinth and CurseForge for their APIs, Adoptium for Java builds, Fabric, Forge and NeoForge for the mod loaders.'}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Classes="faint" Text="{l:T 'Icons: Lucide (ISC license).'}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Classes="faint" Text="{l:T 'Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.'}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
