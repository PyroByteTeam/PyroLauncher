<Window x:Class="PyroLauncher.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PyroLauncher Setup" Icon="/pyro.ico" Width="620" Height="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg0}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource TitleButton}" Content="&#xE8BB;" Click="Close_Click" x:Name="CloseX"/>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="White">
                        <TextBlock Text="P" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>
                    <TextBlock Text="PyroLauncher Setup" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Fg2}"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="36,18,36,28">
                <!-- ============ Main ============ -->
                <DockPanel x:Name="MainPage">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="Heading" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock x:Name="SubHeading" Foreground="{StaticResource Fg2}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
                        <Button x:Name="UninstallLink" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="Uninstall…" Click="ShowUninstall_Click"/>
                        <Button x:Name="PrimaryButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="Install_Click" MinWidth="130"/>
                        <Button x:Name="LaunchButton" DockPanel.Dock="Right" Content="Launch" Click="Launch_Click" Margin="0,0,10,0"/>
                    </DockPanel>
                    <StackPanel x:Name="Options" Margin="0,26,0,0">
                        <TextBlock Text="INSTALL LOCATION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Fg3}" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0"/>
                            <TextBox x:Name="PathBox"/>
                        </DockPanel>
                        <CheckBox x:Name="DesktopShortcut" Content="Create a desktop shortcut" IsChecked="True" Margin="0,16,0,0"/>
                        <TextBlock Foreground="{StaticResource Fg3}" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"
                                   Text="Installs for the current user only — no administrator rights needed. Your instances and settings live in %APPDATA%\PyroLauncher and are kept across updates."/>
                    </StackPanel>
                </DockPanel>

                <!-- ============ Uninstall ============ -->
                <DockPanel x:Name="UninstallPage" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Uninstall PyroLauncher" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock x:Name="UninstallInfo" Foreground="{StaticResource Fg2}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
                        <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="Back" Click="Back_Click"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Uninstall" Click="Uninstall_Click" MinWidth="130"/>
                    </DockPanel>
                    <StackPanel Margin="0,26,0,0">
                        <CheckBox x:Name="RemoveData" Content="Also delete my instances, worlds, accounts and settings"/>
                        <TextBlock x:Name="DataPath" Foreground="{StaticResource Fg3}" FontSize="12" Margin="27,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Foreground="{StaticResource Fg2}" FontSize="12" Margin="27,10,0,0" TextWrapping="Wrap"
                                   Text="Leave this unticked to keep everything so a later reinstall picks up where you left off. Deleting it cannot be undone."/>
                    </StackPanel>
                </DockPanel>

                <!-- ============ Progress / done ============ -->
                <DockPanel x:Name="ProgressPage" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="ProgressHeading" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock x:Name="ProgressText" Foreground="{StaticResource Fg2}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
                        <Button x:Name="FinishButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Finish" Click="Finish_Click" MinWidth="130" Visibility="Collapsed"/>
                        <CheckBox x:Name="LaunchAfter" DockPanel.Dock="Left" Content="Launch PyroLauncher" IsChecked="True" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </DockPanel>
                    <ProgressBar x:Name="Bar" Margin="0,40,0,0" VerticalAlignment="Top" Maximum="1"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
