<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PyroLauncher.Setup</AssemblyName>
    <RootNamespace>PyroLauncher.Installer</RootNamespace>
    <Version>1.4.0</Version>
    <Product>PyroLauncher Setup</Product>
    <ApplicationIcon>pyro.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="pyro.ico" />
    <Resource Include="logo.png" />
    <!-- Produced by build-installer.ps1: the published launcher, zipped, plus version.txt inside. -->
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
