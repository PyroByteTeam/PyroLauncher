<Window x:Class="PyroLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:PyroLauncher.UI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PyroLauncher.UI.Controls"
        Title="{l:T 'PyroLauncher'}" Icon="/Assets/pyro.ico" Width="1280" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Top" Height="64">
                    <Border Width="40" Height="40" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="{l:T 'PyroLauncher'}">
                        <Border.Background><ImageBrush ImageSource="/Assets/logo.png" Stretch="UniformToFill"/></Border.Background>
                    </Border>
                </Border>

                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <RadioButton Style="{StaticResource NavButton}" Content="{l:T 'Home'}" Tag="&#xE80F;" GroupName="nav"
                                 IsChecked="{Binding Nav, Converter={StaticResource Eq}, ConverterParameter=home}"
                                 Command="{Binding GoHomeCommand}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="{l:T 'Servers'}" ToolTip="{l:T 'Server packs'}" Tag="&#xE968;" GroupName="nav"
                                 IsChecked="{Binding Nav, Converter={StaticResource Eq}, ConverterParameter=serverpacks}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="{l:T 'Discover'}" Tag="&#xE909;" GroupName="nav"
                                 IsChecked="{Binding Nav, Converter={StaticResource Eq}, ConverterParameter=discover}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="{l:T 'Profile'}" Tag="&#xE77B;" GroupName="nav"
                                 IsChecked="{Binding Nav, Converter={StaticResource Eq}, ConverterParameter=profile}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="{l:T 'Presets'}" Tag="&#xE8FD;" GroupName="nav"
                                 IsChecked="{Binding Nav, Converter={StaticResource Eq}, ConverterParameter=presets}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="{l:T 'Downloads'}" Tag="&#xE896;" GroupName="nav"
                                 IsChecked="{Binding Nav, Converter={StaticResource Eq}, ConverterParameter=downloads}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="{l:T 'Settings'}" Tag="&#xE713;" GroupName="nav"
                                 IsChecked="{Binding Nav, Converter={StaticResource Eq}, ConverterParameter=settings}"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Margin="0,0,0,14" Command="{Binding OpenAccountsCommand}" Style="{StaticResource GhostButton}"
                        Width="56" Height="56" Padding="0" ToolTip="{l:T 'Accounts'}">
                    <Grid>
                        <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Bg3}" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource Fg2}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image c:RemoteImage.DecodeWidth="64" c:RemoteImage.Url="{Binding Account.AvatarUrl}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Button>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding AccountLabel}" FontSize="10"
                           Foreground="{StaticResource Fg3}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="68" Margin="0,0,0,2"/>
            </DockPanel>
        </Border>

        <!-- ============ Main area ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Download pill (visible while something downloads) -->
            <Button HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding GoDownloadsCommand}" Padding="14,5"
                    WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:T 'Open downloads'}"
                    Visibility="{Binding Downloads.IsActive, Converter={StaticResource VisibleIf}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,9,0" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{l:T 'Downloading'}"/><Run Text="{Binding Downloads.ActiveCount, Mode=OneWay, StringFormat={} ({0})}" Foreground="{StaticResource Fg2}"/>
                    </TextBlock>
                    <ProgressBar Width="120" Margin="12,0,12,0" VerticalAlignment="Center"
                                 Value="{Binding Downloads.Progress, Converter={StaticResource Percent}, Mode=OneWay}"
                                 IsIndeterminate="{Binding Downloads.Progress, Converter={StaticResource Indeterminate}, Mode=OneWay}"/>
                    <TextBlock Text="{Binding Downloads.Text}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" MinWidth="110"/>
                </StackPanel>
            </Button>

            <!-- Title bar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="36">
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" ToolTip="{l:T 'Minimize'}" Click="Minimize_Click"/>
                <Button Style="{StaticResource TitleBarButton}" x:Name="MaxButton" Content="&#xE922;" ToolTip="{l:T 'Maximize'}" Click="Maximize_Click"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="{l:T 'Close'}" Click="Close_Click"/>
            </StackPanel>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False"/>
        </Grid>

        <!-- ============ Dialog overlay ============ -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding Dialog, Converter={StaticResource VisibleIf}}" Background="{StaticResource Scrim}">
            <ContentControl Content="{Binding Dialog}" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"/>
        </Grid>

        <!-- ============ Toasts ============ -->
        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Width="380">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,8,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.6" Color="Black"/>
                        </Border.Effect>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE8BB;" VerticalAlignment="Top" ToolTip="{l:T 'Dismiss'}"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,1,12,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
