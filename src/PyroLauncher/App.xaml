<Application x:Class="PyroLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PyroLauncher.UI"
             xmlns:vm="clr-namespace:PyroLauncher.UI.ViewModels"
             xmlns:v="clr-namespace:PyroLauncher.UI.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ui:VisibleIfConverter x:Key="VisibleIf"/>
            <ui:InvertBoolConverter x:Key="Not"/>
            <ui:EqualsConverter x:Key="Eq"/>
            <ui:PercentConverter x:Key="Percent"/>
            <ui:IndeterminateConverter x:Key="Indeterminate"/>
            <ui:NullableIntConverter x:Key="NullableInt"/>
            <ui:MemoryConverter x:Key="Memory"/>
            <ui:MbToGbConverter x:Key="MbToGb"/>

            <!-- ViewModel → View mapping -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DownloadsViewModel}"><v:DownloadsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileViewModel}"><v:ProfileView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstanceViewModel}"><v:InstanceView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ContentTabViewModel}"><v:ContentTabView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProjectDetailViewModel}"><v:ProjectDetailView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ScreenshotsViewModel}"><v:ScreenshotsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ServersViewModel}"><v:ServersView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogsViewModel}"><v:LogsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfigsViewModel}"><v:ConfigsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstanceSettingsViewModel}"><v:InstanceSettingsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:NewInstanceViewModel}"><v:NewInstanceView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountsViewModel}"><v:AccountsView/></DataTemplate>
            <DataTemplate DataType="{x:Type ui:ConfirmDialogViewModel}"><v:ConfirmDialogView/></DataTemplate>
            <DataTemplate DataType="{x:Type ui:PromptDialogViewModel}"><v:PromptDialogView/></DataTemplate>
            <DataTemplate DataType="{x:Type ui:ChoiceDialogViewModel}"><v:ChoiceDialogView/></DataTemplate>
            <DataTemplate DataType="{x:Type ui:ImageViewerViewModel}"><v:ImageViewerView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ManualDownloadsViewModel}"><v:ManualDownloadsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiscoverViewModel}"><v:DiscoverView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ServerPacksViewModel}"><v:ServerPacksView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExportViewModel}"><v:ExportView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PresetsViewModel}"><v:PresetsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ApplyPresetViewModel}"><v:ApplyPresetView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModpackPageViewModel}"><v:ModpackPageView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
