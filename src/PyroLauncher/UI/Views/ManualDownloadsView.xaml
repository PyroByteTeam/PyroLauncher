<UserControl x:Class="PyroLauncher.UI.Views.ManualDownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:PyroLauncher.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <Border Style="{StaticResource DialogCard}" Width="680">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{l:T 'Some files need a manual download'}" Style="{StaticResource H2}"/>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,4"
                           Text="{l:T 'The authors of these mods don\'t allow other launchers to download them. Open the pages in your browser and download each file - files saved to your Downloads folder are moved into the instance automatically.'}"/>
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,8,0,14"/>
            </StackPanel>
            <!-- Two rows so long (e.g. Russian) labels never get clipped -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <WrapPanel>
                    <Button Command="{Binding OpenFolderCommand}" Style="{StaticResource GhostButton}" Margin="-10,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T 'Open mods folder'}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CollectCommand}" Style="{StaticResource GhostButton}" ToolTip="{l:T 'Look for the files in your Downloads folder again'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T 'Check Downloads'}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Content="{l:T 'Done'}" Command="{Binding CloseCommand}" IsCancel="True" MinWidth="100"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding OpenAllCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T 'Open all in browser'}"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </StackPanel>
            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Bg3}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button x:Name="open" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4"
                                            Command="{Binding DataContext.OpenCommand, ElementName=Self}" CommandParameter="{Binding}" ToolTip="{l:T 'Open the download page'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{l:T 'Open page'}"/>
                                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="state" DockPanel.Dock="Left" Text="&#xE896;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Fg3}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="state" Property="Text" Value="&#xE73E;"/>
                                    <Setter TargetName="state" Property="Foreground" Value="{StaticResource Fg}"/>
                                    <Setter TargetName="open" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
