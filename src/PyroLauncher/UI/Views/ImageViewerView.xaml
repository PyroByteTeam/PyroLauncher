<UserControl x:Class="PyroLauncher.UI.Views.ImageViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:PyroLauncher.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PyroLauncher.UI.Controls"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.InputBindings>
        <KeyBinding Key="Left" Command="{Binding PreviousCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NextCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="NavArrow" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="24" Background="#B0000000" BorderBrush="#40FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White"
                                              TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="16"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E6000000"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid MaxWidth="1400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:T 'Open externally'}" Command="{Binding OpenExternalCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CloseCommand}" IsCancel="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T 'Close'}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="0,0,14,0" VerticalAlignment="Center"
                    Visibility="{Binding HasMany, Converter={StaticResource VisibleIf}}">
                <TextBlock Text="{Binding PositionText}" Style="{StaticResource BadgeText}" FontFamily="{StaticResource MonoFont}"/>
            </Border>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Border Grid.Row="1" CornerRadius="10" ClipToBounds="True" Background="{StaticResource Bg1}">
            <Grid>
                <Image Source="{Binding LocalUri}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Image c:RemoteImage.DecodeWidth="1920" c:RemoteImage.Url="{Binding Url}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Button Style="{StaticResource NavArrow}" HorizontalAlignment="Left" Margin="14,0,0,0" Content="&#xE76B;"
                        Command="{Binding PreviousCommand}" ToolTip="{l:T 'Previous (Left arrow)'}"
                        Visibility="{Binding HasMany, Converter={StaticResource VisibleIf}}"/>
                <Button Style="{StaticResource NavArrow}" HorizontalAlignment="Right" Margin="0,0,14,0" Content="&#xE76C;"
                        Command="{Binding NextCommand}" ToolTip="{l:T 'Next (Right arrow)'}"
                        Visibility="{Binding HasMany, Converter={StaticResource VisibleIf}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
