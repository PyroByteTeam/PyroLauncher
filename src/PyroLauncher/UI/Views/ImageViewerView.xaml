<UserControl x:Class="PyroLauncher.UI.Views.ImageViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PyroLauncher.UI.Controls">
    <Grid MaxWidth="1400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Open externally" Command="{Binding OpenExternalCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CloseCommand}" IsCancel="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Close"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Border Grid.Row="1" CornerRadius="10" ClipToBounds="True" Background="{StaticResource Bg1}">
            <Grid>
                <Image Source="{Binding LocalUri}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Image c:RemoteImage.DecodeWidth="1920" c:RemoteImage.Url="{Binding Url}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
