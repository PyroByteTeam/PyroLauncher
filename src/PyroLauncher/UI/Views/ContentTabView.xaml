<UserControl x:Class="PyroLauncher.UI.Views.ContentTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:PyroLauncher.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PyroLauncher.UI.Controls"
             xmlns:content="clr-namespace:PyroLauncher.Content"
             x:Name="Self" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <UserControl.Resources>
        <!-- Icon with initials fallback -->
        <DataTemplate x:Key="ItemIcon">
            <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource Bg3}" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image c:RemoteImage.DecodeWidth="80" c:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                    <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Grid>
            </Border>
        </DataTemplate>

        <ContextMenu x:Key="ItemMenu" x:Shared="False" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{l:T 'Toggle on / off'}" Tag="&#xE8FB;" Command="{Binding ToggleCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="{l:T 'Show in Explorer'}" Tag="&#xE838;" Command="{Binding RevealCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="{l:T 'Delete'}" Tag="&#xE74D;" Command="{Binding DeleteCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <!-- Installed: list row -->
        <DataTemplate x:Key="InstalledRow">
            <Border x:Name="row" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                    Padding="12,8" Margin="0,0,0,6" Cursor="Hand" Tag="{Binding DataContext, ElementName=Self}" ContextMenu="{StaticResource ItemMenu}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenItemCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="chk" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Hidden" ToolTip="{l:T 'Select for bulk actions'}"/>
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,12,0"
                              ToolTip="{Binding DataContext.ToggleTooltip, ElementName=Self}"/>
                    <ContentPresenter x:Name="icon" Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource ItemIcon}" Margin="0,0,12,0"/>
                    <StackPanel x:Name="text" Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                            <Run Text="{Binding Version, Mode=OneWay}"/><Run Text="  ·  " Foreground="{StaticResource Line2}"/><Run Text="{Binding FileName, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="4" Padding="10,4" Margin="8,0,6,0" Style="{StaticResource PrimaryButton}" FontSize="12"
                            ToolTip="{Binding Update.Name}" Visibility="{Binding HasUpdate, Converter={StaticResource VisibleIf}}"
                            Command="{Binding DataContext.UpdateItemCommand, ElementName=Self}" CommandParameter="{Binding}">
                        <TextBlock MaxWidth="120" TextTrimming="CharacterEllipsis" Text="{Binding Update.VersionNumber, StringFormat=Update → {0}}"/>
                    </Button>
                    <Border Grid.Column="5" Style="{StaticResource Badge}">
                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource BadgeText}"/>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{StaticResource Bg3}"/>
                    <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Line2}"/>
                    <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding DataContext.HasChecked, ElementName=Self}" Value="True">
                    <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="row" Property="Background" Value="#FF202020"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Fg}"/>
                    <Setter TargetName="row" Property="Background" Value="{StaticResource Bg3}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="icon" Property="Opacity" Value="0.35"/>
                    <Setter TargetName="text" Property="Opacity" Value="0.45"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Installed: grid tile -->
        <DataTemplate x:Key="InstalledTile">
            <Border x:Name="tile" Width="96" Height="108" Margin="0,0,8,8" CornerRadius="10" Background="{StaticResource Bg2}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Cursor="Hand" ToolTip="{Binding Name}"
                    Tag="{Binding DataContext, ElementName=Self}" ContextMenu="{StaticResource ItemMenu}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenItemCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.ToggleCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <StackPanel x:Name="content" Margin="6,10,6,6">
                        <Border Width="52" Height="52" CornerRadius="10" Background="{StaticResource Bg3}" ClipToBounds="True" HorizontalAlignment="Center">
                            <Grid>
                                <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image c:RemoteImage.DecodeWidth="104" c:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                                <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="11.5" Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                    </StackPanel>
                    <Ellipse Width="8" Height="8" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,34"
                             Visibility="{Binding HasUpdate, Converter={StaticResource VisibleIf}}" ToolTip="{l:T 'Update available'}"/>
                    <Border x:Name="off" Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Padding="4,0" Visibility="Collapsed">
                        <TextBlock Text="{l:T 'OFF'}" Style="{StaticResource BadgeText}" FontSize="9"/>
                    </Border>
                    <CheckBox x:Name="chk" IsChecked="{Binding IsChecked}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Visibility="Hidden"
                              ToolTip="{l:T 'Select for bulk actions'}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="tile" Property="Background" Value="{StaticResource Bg3}"/>
                    <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource Line2}"/>
                    <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding DataContext.HasChecked, ElementName=Self}" Value="True">
                    <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="tile" Property="Background" Value="#FF242424"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource Fg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="content" Property="Opacity" Value="0.35"/>
                    <Setter TargetName="off" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Suggestions: list row -->
        <DataTemplate x:Key="SuggestionRow">
            <Border x:Name="row" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                    Padding="12,9" Margin="0,0,0,6" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenProjectCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="9" Background="{StaticResource Bg3}" ClipToBounds="True" Margin="0,0,12,0">
                        <Grid>
                            <TextBlock Text="{Binding Initials}" FontWeight="Bold" Foreground="{StaticResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image c:RemoteImage.DecodeWidth="84" c:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="{Binding Author, Mode=OneWay, StringFormat=by {0}}" Foreground="{StaticResource Fg3}" FontSize="12"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0" HorizontalAlignment="Right">
                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource BadgeText}"/>
                        </Border>
                        <TextBlock Text="{Binding DownloadsText, StringFormat=↓ {0}}" Style="{StaticResource Faint}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" Content="{l:T 'Install'}" Padding="12,6"
                            Command="{Binding DataContext.QuickInstallCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{StaticResource Bg3}"/>
                    <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Line2}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Fg}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Suggestions: grid tile -->
        <DataTemplate x:Key="SuggestionTile">
            <Border x:Name="tile" Width="96" Height="108" Margin="0,0,8,8" CornerRadius="10" Background="{StaticResource Bg2}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Cursor="Hand" ToolTip="{Binding Description}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenProjectCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <StackPanel Margin="6,10,6,6">
                    <Border Width="52" Height="52" CornerRadius="10" Background="{StaticResource Bg3}" ClipToBounds="True" HorizontalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image c:RemoteImage.DecodeWidth="104" c:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="11.5" Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="tile" Property="Background" Value="{StaticResource Bg3}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource Fg}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate"><WrapPanel/></ItemsPanelTemplate>

        <Style x:Key="ListOnly" TargetType="ItemsControl">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGrid}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridOnly" TargetType="ItemsControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGrid}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="{Binding DetailWidth}"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Left: list ================= -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="{l:T 'Add files from disk'}" Command="{Binding AddFilesCommand}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="{l:T 'Open folder'}" Command="{Binding OpenFolderCommand}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="{l:T 'Refresh'}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="{l:T 'Suggestions'}" IsChecked="{Binding SuggestionsEnabled}" Margin="14,0,10,0"
                          VerticalAlignment="Center" ToolTip="{l:T 'Also search Modrinth and CurseForge for content you don\'t have yet'}"/>
                <ComboBox DockPanel.Dock="Right" Width="120" Margin="10,0,0,0" SelectedItem="{Binding SourceFilter}"
                          Visibility="{Binding SuggestionsEnabled, Converter={StaticResource VisibleIf}}">
                    <x:Static Member="content:SourceFilter.All"/>
                    <x:Static Member="content:SourceFilter.Modrinth"/>
                    <x:Static Member="content:SourceFilter.CurseForge"/>
                </ComboBox>
                <Grid>
                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding SearchPlaceholder}" Padding="34,8,10,8"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Fg3}" FontSize="13"
                               VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>

            <!-- Filters + banners -->
            <StackPanel Grid.Row="1">
                <WrapPanel Margin="0,0,0,8">
                    <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T 'All'}" Padding="12,6" Margin="0,0,6,6" GroupName="{Binding Title}"
                                 IsChecked="{Binding StatusFilter, Converter={StaticResource Eq}, ConverterParameter=all}"/>
                    <RadioButton Style="{StaticResource SegmentButton}" Content="{Binding EnabledFilterText}" Padding="12,6" Margin="0,0,6,6" GroupName="{Binding Title}"
                                 IsChecked="{Binding StatusFilter, Converter={StaticResource Eq}, ConverterParameter=enabled}"/>
                    <RadioButton Style="{StaticResource SegmentButton}" Content="{Binding DisabledFilterText}" Padding="12,6" Margin="0,0,6,6" GroupName="{Binding Title}"
                                 IsChecked="{Binding StatusFilter, Converter={StaticResource Eq}, ConverterParameter=disabled}"/>
                    <RadioButton Style="{StaticResource SegmentButton}" Padding="12,6" Margin="0,0,14,6" GroupName="{Binding Title}"
                                 IsChecked="{Binding StatusFilter, Converter={StaticResource Eq}, ConverterParameter=updates}">
                        <TextBlock Text="{Binding UpdatesCount, StringFormat=Updates ({0})}"/>
                    </RadioButton>
                    <Button Command="{Binding CheckUpdatesCommand}" Padding="12,6" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T 'Check for updates'}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding UpdateAllCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6" Padding="12,6"
                            Visibility="{Binding UpdatesCount, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="{Binding UpdatesCount, StringFormat=Update all ({0})}"/>
                    </Button>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8" Visibility="{Binding SuggestionsEnabled, Converter={StaticResource VisibleIf}}">
                    <ComboBox Width="130" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" Margin="0,0,8,6" ToolTip="{l:T 'Sort suggestions'}"/>
                    <ComboBox Width="160" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Margin="0,0,8,6" ToolTip="{l:T 'Category'}"/>
                    <ComboBox Width="110" ItemsSource="{Binding Environments}" SelectedItem="{Binding Environment}" Margin="0,0,8,6" ToolTip="{l:T 'Client / server side'}"
                              Visibility="{Binding IsMods, Converter={StaticResource VisibleIf}}"/>
                </WrapPanel>
                <!-- Bulk actions (appears when items are ticked) -->
                <Border Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                        Visibility="{Binding HasChecked, Converter={StaticResource VisibleIf}}">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="SemiBold">
                            <Run Text="{Binding CheckedCount, Mode=OneWay}"/><Run Text="{l:T ' selected'}"/>
                        </TextBlock>
                        <Button Content="{l:T 'Select all shown'}" Style="{StaticResource GhostButton}" Padding="10,5" Command="{Binding SelectAllVisibleCommand}"/>
                        <Button Content="{l:T 'Turn on'}" Padding="10,5" Margin="4,0,0,0" Command="{Binding BulkEnableCommand}" CommandParameter="true"/>
                        <Button Content="{l:T 'Turn off'}" Padding="10,5" Margin="6,0,0,0" Command="{Binding BulkEnableCommand}" CommandParameter="false"/>
                        <Button Padding="10,5" Margin="6,0,0,0" Command="{Binding BulkUpdateCommand}">
                            <TextBlock Text="{Binding CheckedUpdates, StringFormat=Update ({0})}"/>
                        </Button>
                        <Button Content="{l:T 'Delete'}" Padding="10,5" Margin="6,0,0,0" Command="{Binding BulkDeleteCommand}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Width="28" Height="28" Margin="6,0,0,0"
                                ToolTip="{l:T 'Clear selection'}" Command="{Binding ClearCheckedCommand}"/>
                    </WrapPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="2,0,0,10" Visibility="{Binding UpdateStatus, Converter={StaticResource VisibleIf}}">
                    <ProgressBar Width="80" IsIndeterminate="True" Margin="0,0,10,0" Visibility="{Binding IsCheckingUpdates, Converter={StaticResource VisibleIf}}"/>
                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12" Visibility="{Binding IsUnsupported, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="{l:T 'This is a vanilla instance - mods need Fabric, Forge or NeoForge. Create a modded instance to use mods.'}" TextWrapping="Wrap" Foreground="{StaticResource Fg2}"/>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12" Visibility="{Binding BusyText, Converter={StaticResource VisibleIf}}">
                    <StackPanel>
                        <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource Fg2}"/>
                        <ProgressBar IsIndeterminate="True" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer x:Name="ListScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,20">
                <StackPanel>
                    <DockPanel Margin="2,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Faint}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T 'INSTALLED'}" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Margin="0,0,0,10" Visibility="{Binding List.IsLoading, Converter={StaticResource VisibleIf}}"/>
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" Margin="2,4,0,16" TextWrapping="Wrap"
                               Visibility="{Binding Installed.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>

                    <ItemsControl ItemsSource="{Binding InstalledView}" ItemTemplate="{StaticResource InstalledRow}" Style="{StaticResource ListOnly}"/>
                    <ItemsControl ItemsSource="{Binding InstalledView}" ItemTemplate="{StaticResource InstalledTile}" Style="{StaticResource GridOnly}"
                                  ItemsPanel="{StaticResource WrapPanelTemplate}"/>

                    <StackPanel Visibility="{Binding SuggestionsEnabled, Converter={StaticResource VisibleIf}}" Margin="0,18,0,0">
                        <DockPanel Margin="2,0,0,10">
                            <TextBlock Text="{l:T 'SUGGESTIONS'}" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T '  ·  not installed'}" Style="{StaticResource Faint}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" Margin="0,0,0,10" Visibility="{Binding IsSearching, Converter={StaticResource VisibleIf}}"/>
                        <TextBlock Text="{Binding SearchWarning}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,0,0,10"
                                   Visibility="{Binding SearchWarning, Converter={StaticResource VisibleIf}}"/>
                        <ItemsControl ItemsSource="{Binding Suggestions}" ItemTemplate="{StaticResource SuggestionRow}" Style="{StaticResource ListOnly}"/>
                        <ItemsControl ItemsSource="{Binding Suggestions}" ItemTemplate="{StaticResource SuggestionTile}" Style="{StaticResource GridOnly}"
                                      ItemsPanel="{StaticResource WrapPanelTemplate}"/>
                        <Button Content="{l:T 'Load more'}" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                Visibility="{Binding CanLoadMore, Converter={StaticResource VisibleIf}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= Right: details ================= -->
        <Border Grid.Column="1" Margin="16,0,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="18,0,0,0"
                Visibility="{Binding Detail, Converter={StaticResource VisibleIf}}">
            <ContentControl Content="{Binding Detail}" Focusable="False"/>
        </Border>
    </Grid>
</UserControl>
