<Window x:Class="PyroLauncher.UI.Views.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:PyroLauncher.UI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PyroLauncher.UI.Controls"
        Width="980" Height="620" MinWidth="560" MinHeight="320"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <DockPanel Background="{StaticResource Bg1}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" ToolTip="{l:T 'Minimize'}" Click="Min_Click"/>
                <Button Style="{StaticResource TitleBarButton}" x:Name="MaxButton" Content="&#xE922;" ToolTip="{l:T 'Maximize'}" Click="Max_Click"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="{l:T 'Close'}" Click="Close_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE756;" FontFamily="{StaticResource IconFont}" Margin="0,1,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{l:T ' · Console'}" Foreground="{StaticResource Fg2}" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Badge}" Margin="12,0,0,0" Visibility="{Binding IsRunning, Converter={StaticResource VisibleIf}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T 'Running'}" Style="{StaticResource BadgeText}" Foreground="White"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Faint}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="14,12,14,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox Content="{l:T 'Errors &amp; warnings'}" IsChecked="{Binding ErrorsOnly, ElementName=Viewer}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <CheckBox Content="{l:T 'Auto-scroll'}" IsChecked="{Binding AutoScroll, ElementName=Viewer}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <Button Content="{l:T 'Copy'}" Click="Copy_Click" Margin="0,0,6,0" ToolTip="{l:T 'Copy selected lines (or everything if nothing is selected)'}"/>
                <Button Content="{l:T 'Clear'}" Click="Clear_Click" Margin="0,0,6,0"/>
                <Button Content="{l:T 'Logs folder'}" Click="Folder_Click" Margin="0,0,6,0"/>
                <Button x:Name="KillButton" Content="{l:T 'Kill game'}" Click="Kill_Click" Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding IsRunning, Converter={StaticResource VisibleIf}}"/>
            </StackPanel>
            <Grid Margin="0,0,16,0">
                <TextBox x:Name="FilterBox" Tag="{l:T 'Filter lines…'}" Padding="32,7,10,7" TextChanged="Filter_Changed"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Fg3}" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
            </Grid>
        </DockPanel>

        <c:LogViewer x:Name="Viewer" Grid.Row="2" Margin="14,0,14,14" Lines="{Binding LogLines}"/>
    </Grid>
</Window>
