<UserControl x:Class="PyroLauncher.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:PyroLauncher.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <Grid Margin="36,0,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,16,22">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Border Width="220" Margin="0,0,10,0">
                    <Grid>
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T 'Search instances'}" Padding="32,7,10,7"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Fg3}" FontSize="12"
                                   VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <Button Command="{Binding NewCategoryCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T 'New category'}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewInstanceCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T 'New instance'}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{l:T 'Instances'}" Style="{StaticResource H1}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Fg2}" Margin="0,1,7,0" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{Binding TotalPlaytimeText, Mode=OneWay}" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"/><Run Text="{l:T '  total playtime'}" Foreground="{StaticResource Fg2}"/>
                    </TextBlock>
                    <TextBlock Text="{l:T '  ·  drag instances between categories to organize them'}" Style="{StaticResource Faint}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,80"
                    Visibility="{Binding IsEmpty, Converter={StaticResource VisibleIf}}">
            <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Fg2}"/>
            </Border>
            <TextBlock Text="{l:T 'No instances yet'}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
            <TextBlock Text="{l:T 'Create a fresh instance or import a Modrinth / CurseForge modpack.'}" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
            <Button Style="{StaticResource PrimaryButton}" Content="{l:T 'Create your first instance'}" Command="{Binding NewInstanceCommand}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>

        <!-- Groups -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,16,24"
                      Visibility="{Binding IsEmpty, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent" AllowDrop="True" Drop="Group_Drop" DragOver="Group_DragOver" DragLeave="Group_DragLeave"
                                CornerRadius="12" BorderThickness="1" BorderBrush="Transparent" Margin="0,0,0,18" Padding="0,0,0,4">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsUser, Converter={StaticResource VisibleIf}}">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="{l:T 'Rename category'}" Width="30" Height="30" FontSize="12"
                                                Command="{Binding DataContext.RenameCategoryCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{l:T 'Delete category'}" Width="30" Height="30" FontSize="12"
                                                Command="{Binding DataContext.DeleteCategoryCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <ToggleButton IsChecked="{Binding IsExpanded}" Cursor="Hand" Focusable="False" HorizontalAlignment="Left">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                                    <TextBlock x:Name="chev" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Fg3}"
                                                               VerticalAlignment="Center" Margin="0,2,10,0" RenderTransformOrigin="0.5,0.5">
                                                        
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="16"/>
                                                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Items.Count}" Style="{StaticResource BadgeText}"/>
                                                    </Border>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="False">
                                                        <Setter TargetName="chev" Property="RenderTransform"><Setter.Value><RotateTransform Angle="-90"/></Setter.Value></Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </DockPanel>

                                <TextBlock Text="{l:T 'Empty - drag instances here.'}" Style="{StaticResource Faint}" Margin="22,0,0,14"
                                           Visibility="{Binding Items.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>

                                <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsExpanded, Converter={StaticResource VisibleIf}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="card" Width="204" Margin="0,0,14,14" Style="{StaticResource Card}" Cursor="Hand"
                                                    Tag="{Binding DataContext, ElementName=Self}"
                                                    PreviewMouseLeftButtonDown="Card_MouseDown" MouseMove="Card_MouseMove" MouseLeftButtonUp="Card_MouseUp">
                                                <Border.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="{l:T 'Play / Install / Stop'}" Tag="&#xE768;" Command="{Binding LaunchCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="{l:T 'Open'}" Tag="&#xE8A7;" Command="{Binding OpenCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="{l:T 'Open folder'}" Tag="&#xE838;" Command="{Binding OpenFolderCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="{l:T 'Move to category…'}" Tag="&#xE8EC;" Command="{Binding MoveToCategoryCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{l:T 'Delete'}" Tag="&#xE74D;" Command="{Binding DeleteCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="132"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- Art -->
                                                    <Border CornerRadius="11,11,0,0" Background="{StaticResource Bg3}" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource DisplayFont}" FontSize="56" FontWeight="Bold"
                                                                       Foreground="#FF3A3A3A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <!-- Blurred fill behind, whole icon on top: nothing gets cropped -->
                                                            <Image Source="{Binding Icon}" Stretch="UniformToFill" Opacity="0.35" RenderOptions.BitmapScalingMode="LowQuality">
                                                                <Image.Effect><BlurEffect Radius="28" KernelType="Gaussian"/></Image.Effect>
                                                            </Image>
                                                            <Image Source="{Binding Icon}" Stretch="Uniform" Margin="12" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <Border Style="{StaticResource Badge}" Background="#E6000000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                                                                    Visibility="{Binding IsRunning, Converter={StaticResource VisibleIf}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Width="6" Height="6" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{l:T 'Running'}" Style="{StaticResource BadgeText}" Foreground="White"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Button x:Name="play" Style="{StaticResource PrimaryButton}" Width="42" Height="42" Padding="0"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Visibility="Hidden"
                                                                    Command="{Binding DataContext.LaunchCommand, ElementName=Self}" CommandParameter="{Binding}" ToolTip="{l:T 'Play'}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="b" CornerRadius="21" Background="White">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="b" Property="Background" Value="#FFDADADA"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <TextBlock x:Name="playGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="Black" Margin="2,0,0,0"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <!-- Info -->
                                                    <StackPanel Grid.Row="1" Margin="14,12,14,13">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                        <Grid Margin="0,8,0,0">
                                                            <TextBlock Text="{Binding PlayTimeText}" Style="{StaticResource Faint}"
                                                                       Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>
                                                            <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}}">
                                                                <TextBlock Text="{Binding Status}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                                                                <ProgressBar Margin="0,6,0,0" Value="{Binding Progress, Converter={StaticResource Percent}, Mode=OneWay}"
                                                                             IsIndeterminate="{Binding Progress, Converter={StaticResource Indeterminate}, Mode=OneWay}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="play" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Line2}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                    <Setter TargetName="playGlyph" Property="Text" Value="&#xE896;"/>
                                                    <Setter TargetName="playGlyph" Property="Margin" Value="0"/>
                                                    <Setter TargetName="play" Property="ToolTip" Value="{l:T 'Install'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter TargetName="play" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="playGlyph" Property="Text" Value="&#xE71A;"/>
                                                    <Setter TargetName="playGlyph" Property="Margin" Value="0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter TargetName="play" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="playGlyph" Property="Text" Value="&#xE711;"/>
                                                    <Setter TargetName="playGlyph" Property="Margin" Value="0"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
