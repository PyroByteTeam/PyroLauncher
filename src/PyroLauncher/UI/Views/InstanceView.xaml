<UserControl x:Class="PyroLauncher.UI.Views.InstanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,0,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{Binding BackCommand}" ToolTip="Back to instances"
                    VerticalAlignment="Top" Margin="-8,0,10,0"/>
            <Border Grid.Column="1" Width="84" Height="84" CornerRadius="14" Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="{Binding Instance.Initial}" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="Bold"
                               Foreground="#FF4A4A4A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding Instance.Icon}" Stretch="UniformToFill"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="2" Margin="20,2,20,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Instance.Name}" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Style="{StaticResource Badge}">
                        <TextBlock Text="{Binding Instance.Config.MinecraftVersion}" Style="{StaticResource BadgeText}"/>
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="6,0,0,0">
                        <TextBlock Style="{StaticResource BadgeText}">
                            <Run Text="{Binding Instance.LoaderText, Mode=OneWay}"/> <Run Text="{Binding Instance.ShortLoaderVersion, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Fg2}" Margin="16,1,6,0" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Fg}">
                        <Run Text="{Binding Instance.PlayTimeClock, Mode=OneWay}" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"/><Run Text=" played" Foreground="{StaticResource Fg2}"/>
                    </TextBlock>
                    <TextBlock Text="·" Foreground="{StaticResource Fg3}" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Instance.LastPlayedText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Width="230">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xE756;" ToolTip="Open console" Command="{Binding OpenConsoleCommand}" Margin="0,0,4,0" Width="44" Height="44"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Open game folder" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" Width="44" Height="44"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding LaunchCommand}" Padding="26,11" FontSize="15" MinWidth="140">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LaunchGlyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LaunchText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Visibility="{Binding Instance.IsBusy, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="{Binding Instance.Status}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                    <ProgressBar Margin="0,6,0,0" Value="{Binding Instance.Progress, Converter={StaticResource Percent}, Mode=OneWay}"
                                 IsIndeterminate="{Binding Instance.Progress, Converter={StaticResource Indeterminate}, Mode=OneWay}"/>
                </StackPanel>
                <TextBlock Text="Game is running" Style="{StaticResource Faint}" HorizontalAlignment="Right" Margin="0,10,0,0"
                           Visibility="{Binding Instance.IsRunning, Converter={StaticResource VisibleIf}}"/>
            </StackPanel>
        </Grid>

        <!-- Tabs -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource TabButton}" Content="Mods" Tag="&#xEA86;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=mods}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Resource Packs" Tag="&#xE790;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=resourcepacks}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Shaders" Tag="&#xE706;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=shaders}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Screenshots" Tag="&#xEB9F;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=screenshots}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Servers" Tag="&#xE774;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=servers}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Logs" Tag="&#xE9D9;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=logs}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Settings" Tag="&#xE713;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=settings}"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentTab}" Focusable="False"/>
    </Grid>
</UserControl>
