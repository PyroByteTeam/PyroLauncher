<UserControl x:Class="PyroLauncher.UI.Views.InstanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <Grid Margin="36,0,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{Binding BackCommand}" ToolTip="Back to instances"
                    VerticalAlignment="Top" Margin="-8,0,10,0"/>
            <Border Grid.Column="1" Width="84" Height="84" CornerRadius="14" Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="{Binding Instance.Initial}" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="Bold"
                               Foreground="#FF4A4A4A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding Instance.Icon}" Stretch="UniformToFill"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="2" Margin="20,2,20,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Instance.Name}" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Style="{StaticResource Badge}">
                        <TextBlock Text="{Binding Instance.Config.MinecraftVersion}" Style="{StaticResource BadgeText}"/>
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="6,0,0,0">
                        <TextBlock Style="{StaticResource BadgeText}">
                            <Run Text="{Binding Instance.LoaderText, Mode=OneWay}"/> <Run Text="{Binding Instance.ShortLoaderVersion, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Fg2}" Margin="16,1,6,0" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{Binding Instance.PlayTimeClock, Mode=OneWay}" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"/><Run Text=" played" Foreground="{StaticResource Fg2}"/>
                    </TextBlock>
                    <TextBlock Text="·" Foreground="{StaticResource Fg3}" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Instance.LastPlayedText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Width="240">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xE756;" ToolTip="Open console" Command="{Binding OpenConsoleCommand}" Margin="0,0,4,0" Width="44" Height="44"
                            Visibility="{Binding ConsoleEnabled, Converter={StaticResource VisibleIf}}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Open game folder" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" Width="44" Height="44"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding LaunchCommand}" Padding="26,11" FontSize="15" MinWidth="140">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LaunchGlyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LaunchText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Visibility="{Binding Instance.IsBusy, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="{Binding Instance.Status}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                    <ProgressBar Margin="0,6,0,0" Value="{Binding Instance.Progress, Converter={StaticResource Percent}, Mode=OneWay}"
                                 IsIndeterminate="{Binding Instance.Progress, Converter={StaticResource Indeterminate}, Mode=OneWay}"/>
                </StackPanel>
                <TextBlock Text="Game is running" Style="{StaticResource Faint}" HorizontalAlignment="Right" Margin="0,10,0,0"
                           Visibility="{Binding Instance.IsRunning, Converter={StaticResource VisibleIf}}"/>
            </StackPanel>
        </Grid>

        <!-- Top navigation -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,0,0,18"
                Visibility="{Binding ShowTabs, Converter={StaticResource VisibleIf}}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource TabButton}" Content="Mods" Tag="&#xEA86;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=mods}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Resource Packs" Tag="&#xE790;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=resourcepacks}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Shaders" Tag="&#xE706;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=shaders}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Screenshots" Tag="&#xEB9F;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=screenshots}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Servers" Tag="&#xE774;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=servers}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Logs" Tag="&#xE9D9;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=logs}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Configs" Tag="&#xE90F;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=configs}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Settings" Tag="&#xE713;" GroupName="itab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=settings}"/>
            </StackPanel>
        </Border>

        <!-- Grid menu: breadcrumb back to the overview -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,0,0,18" Padding="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsGridMenu}" Value="True"/>
                                <Condition Binding="{Binding IsOverview}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Command="{Binding ShowOverviewCommand}" Padding="10,6" Margin="-10,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Overview"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="/" Foreground="{StaticResource Fg3}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource H3}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Section content -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentTab}" Focusable="False"
                        Visibility="{Binding IsOverview, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>

        <!-- Grid menu: overview cards (drag to rearrange) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,24"
                      Visibility="{Binding IsOverview, Converter={StaticResource VisibleIf}}">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="card" Style="{StaticResource Card}" Margin="0,0,14,14" Padding="18,16" Height="236" AllowDrop="True" Cursor="SizeAll"
                                PreviewMouseLeftButtonDown="Card_MouseDown" MouseMove="Card_MouseMove" Drop="Card_Drop" DragOver="Card_DragOver" DragLeave="Card_DragLeave"
                                ToolTip="Drag to rearrange">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Button DockPanel.Dock="Right" Command="{Binding DataContext.OpenSectionCommand, ElementName=Self}" CommandParameter="{Binding Key}"
                                            Padding="14,6" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Open"/>
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Fg3}" VerticalAlignment="Center" ToolTip="Drag to rearrange"/>
                                </DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="19" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,8,0,12" TextTrimming="CharacterEllipsis"/>
                                <Grid ClipToBounds="True">
                                    <!-- Icons of the first 50 items (mods / packs / shaders) -->
                                    <ItemsControl ItemsSource="{Binding Icons}" Visibility="{Binding IsContent, Converter={StaticResource VisibleIf}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="ic" Width="26" Height="26" Margin="0,0,4,4" CornerRadius="13" Background="{StaticResource Bg4}" ClipToBounds="True" ToolTip="{Binding Name}">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initials}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Fg2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                            <Image.Clip><EllipseGeometry Center="13,13" RadiusX="13" RadiusY="13"/></Image.Clip>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter TargetName="ic" Property="Opacity" Value="0.3"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Latest screenshots -->
                                    <ItemsControl ItemsSource="{Binding Thumbs}" Visibility="{Binding IsScreenshots, Converter={StaticResource VisibleIf}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Margin="0,0,6,6" Height="48" ClipToBounds="True" Background="{StaticResource Bg3}">
                                                    <Image Source="{Binding}" Stretch="UniformToFill"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Line2}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
