<UserControl x:Class="PyroLauncher.UI.Views.ApplyPresetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:PyroLauncher.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PyroLauncher.UI.Controls"
             x:Name="Self">
    <!-- Embedded on the Presets page: resolves a preset against one instance and installs the ticked items. -->
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="{l:T 'Select all'}" Padding="8,4" Command="{Binding SelectAllCommand}"/>
                <Button Style="{StaticResource GhostButton}" Content="{l:T 'Select none'}" Padding="8,4" Command="{Binding SelectNoneCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Faint}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Margin="0,0,0,10" Visibility="{Binding IsResolving, Converter={StaticResource VisibleIf}}"/>

        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" MinWidth="170">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding InstallText}"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Content="{l:T 'Cancel'}" Command="{Binding CancelInstallCommand}" Margin="0,0,8,0"
                    Visibility="{Binding IsInstalling, Converter={StaticResource VisibleIf}}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Command="{Binding OpenInstanceCommand}" Margin="-10,0,12,0"
                    ToolTip="{l:T 'Open the instance page'}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T 'Open instance'}"/>
                </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding IsInstalling, Converter={StaticResource VisibleIf}}">
                <TextBlock Text="{Binding Status}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Margin="0,4,0,0" Value="{Binding Progress, Converter={StaticResource Percent}, Mode=OneWay}"
                             IsIndeterminate="{Binding Progress, Converter={StaticResource Indeterminate}, Mode=OneWay}"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding RowsView}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Overline}" Margin="2,10,0,6"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="row" Background="{StaticResource Bg3}" CornerRadius="8" Padding="10,7" Margin="0,0,0,5">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6" Background="{StaticResource Bg4}" ClipToBounds="True" Margin="0,0,10,0">
                                    <Grid>
                                        <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image c:RemoteImage.DecodeWidth="60" c:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="state" DockPanel.Dock="Right" Text="&#xE895;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Fg3}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Available">
                                <Setter TargetName="state" Property="Text" Value="&#xE896;"/>
                                <Setter TargetName="state" Property="ToolTip" Value="{l:T 'Can be installed'}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="AlreadyInstalled">
                                <Setter TargetName="state" Property="Text" Value="&#xE73E;"/>
                                <Setter TargetName="state" Property="ToolTip" Value="{l:T 'Already in this instance'}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Unavailable">
                                <Setter TargetName="state" Property="Text" Value="&#xE711;"/>
                                <Setter TargetName="row" Property="Opacity" Value="0.55"/>
                                <Setter TargetName="state" Property="ToolTip" Value="{l:T 'Not available for this version'}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                <Setter TargetName="state" Property="Text" Value="&#xE783;"/>
                                <Setter TargetName="state" Property="ToolTip" Value="{l:T 'Something went wrong'}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter TargetName="state" Property="Text" Value="&#xE73E;"/>
                                <Setter TargetName="state" Property="Foreground" Value="{StaticResource Fg}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
