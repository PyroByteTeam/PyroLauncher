<UserControl x:Class="PyroLauncher.UI.Views.NewInstanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource DialogCard}" Width="580">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" Command="{Binding CancelCommand}" VerticalAlignment="Top"/>
                <TextBlock Text="New instance" Style="{StaticResource H2}" FontSize="20"/>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,18">
                <RadioButton Style="{StaticResource TabButton}" Content="Create" Tag="&#xE710;" GroupName="newmode"
                             IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=create}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Import modpack" Tag="&#xE8B5;" GroupName="newmode"
                             IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=import}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/>
            </StackPanel>

            <!-- ================= Create ================= -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="import">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="NAME" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding NamePlaceholder}"/>

                <TextBlock Text="MINECRAFT VERSION" Style="{StaticResource Overline}" Margin="0,18,0,6"/>
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Content="Show snapshots" IsChecked="{Binding ShowSnapshots}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <Grid>
                        <ComboBox Style="{StaticResource SearchComboBox}" ItemsSource="{Binding VersionsView}" SelectedItem="{Binding SelectedVersion}" Tag="{Binding VersionQuery, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}"/>
                                        <TextBlock Text="{Binding Type}" Style="{StaticResource Faint}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Loading versions…" Style="{StaticResource Faint}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding LoadingVersions, Converter={StaticResource VisibleIf}}"/>
                    </Grid>
                </DockPanel>

                <TextBlock Text="MOD LOADER" Style="{StaticResource Overline}" Margin="0,18,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Vanilla" GroupName="loader"
                                 IsChecked="{Binding Loader, Converter={StaticResource Eq}, ConverterParameter=Vanilla}"/>
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Fabric" GroupName="loader"
                                 IsChecked="{Binding Loader, Converter={StaticResource Eq}, ConverterParameter=Fabric}"/>
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Forge" GroupName="loader"
                                 IsChecked="{Binding Loader, Converter={StaticResource Eq}, ConverterParameter=Forge}"/>
                    <RadioButton Style="{StaticResource SegmentButton}" Content="NeoForge" GroupName="loader"
                                 IsChecked="{Binding Loader, Converter={StaticResource Eq}, ConverterParameter=NeoForge}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsVanilla, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                    <TextBlock Text="LOADER VERSION" Style="{StaticResource Overline}" Margin="0,18,0,6"/>
                    <Grid>
                        <ComboBox Style="{StaticResource SearchComboBox}" ItemsSource="{Binding LoaderVersionsView}" SelectedItem="{Binding SelectedLoaderVersion}" Tag="{Binding LoaderQuery, Mode=TwoWay}"/>
                        <TextBlock Text="Loading…" Style="{StaticResource Faint}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding LoadingLoaderVersions, Converter={StaticResource VisibleIf}}"/>
                    </Grid>
                    <TextBlock Text="{Binding LoaderMessage}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding LoaderMessage, Converter={StaticResource VisibleIf}}"/>
                </StackPanel>

                <TextBlock Text="CATEGORY" Style="{StaticResource Overline}" Margin="0,18,0,6"/>
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>

                <DockPanel Margin="0,26,0,0">
                    <TextBlock Text="The instance is created empty; game files download on first launch." Style="{StaticResource Faint}"
                               VerticalAlignment="Center" TextWrapping="Wrap" Width="300"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
                        <Button Content="Create instance" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <!-- ================= Import ================= -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="import">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border x:Name="DropZone" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" Background="{StaticResource Bg1}"
                        BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="10" Padding="20,26">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="26" HorizontalAlignment="Center" Foreground="{StaticResource Fg2}"/>
                        <TextBlock Text="Drop a .mrpack (Modrinth) or .zip (CurseForge) here" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="or" Style="{StaticResource Faint}" HorizontalAlignment="Center"/>
                        <Button Content="Choose file…" Command="{Binding BrowseImportCommand}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,14,0,0" Visibility="{Binding ImportInfo, Converter={StaticResource VisibleIf}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ImportInfo.Name}" Style="{StaticResource H3}"/>
                            <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding ImportInfo.Format}" Style="{StaticResource BadgeText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                            <Run Text="Minecraft"/> <Run Text="{Binding ImportInfo.MinecraftVersion, Mode=OneWay}"/>
                            <Run Text=" · "/><Run Text="{Binding ImportInfo.Loader, Mode=OneWay}"/>
                            <Run Text="{Binding ImportInfo.LoaderVersion, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding ImportPath}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding ImportInfo, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="NAME" Style="{StaticResource Overline}" Margin="0,16,0,6"/>
                    <TextBox Text="{Binding ImportName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/>
                    <TextBlock Text="CATEGORY" Style="{StaticResource Overline}" Margin="0,16,0,6"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/>
                </StackPanel>

                <TextBlock Text="{Binding ImportError}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource Fg}"
                           Visibility="{Binding ImportError, Converter={StaticResource VisibleIf}}"/>

                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Margin="0,8,0,0" Value="{Binding Progress, Converter={StaticResource Percent}, Mode=OneWay}"
                                 IsIndeterminate="{Binding Progress, Converter={StaticResource Indeterminate}, Mode=OneWay}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
                    <Button Content="Import" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
