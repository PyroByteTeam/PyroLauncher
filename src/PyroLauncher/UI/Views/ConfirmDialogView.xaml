<UserControl x:Class="PyroLauncher.UI.Views.ConfirmDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource DialogCard}" Width="460">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource Fg2}" LineHeight="20"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
