<UserControl x:Class="PyroLauncher.UI.Views.ServerPacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:PyroLauncher.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,0,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{l:T 'Server packs'}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T 'Set up and run Minecraft servers from your modpacks.'}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,80" MaxWidth="460">
            <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Fg2}"/>
            </Border>
            <TextBlock Text="{l:T 'Server packs - coming soon'}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
            <TextBlock Text="{l:T 'Download, configure and start servers for your modpacks right from the launcher. Until then, server files for a modpack are available on its page in Discover.'}"
                       Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button Command="{Binding OpenDiscoverCommand}" HorizontalAlignment="Center" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE909;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T 'Open Discover'}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
