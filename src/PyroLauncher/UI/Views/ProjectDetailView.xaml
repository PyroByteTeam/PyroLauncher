<UserControl x:Class="PyroLauncher.UI.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PyroLauncher.UI.Controls"
             x:Name="Self">
    <UserControl.Resources>
        <Style x:Key="InfoChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{Binding BackCommand}" ToolTip="Back" VerticalAlignment="Top" Margin="-8,0,8,0"/>
            <Border Grid.Column="1" Width="72" Height="72" CornerRadius="14" Background="{StaticResource Bg3}" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="&#xEA86;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{StaticResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image c:RemoteImage.DecodeWidth="144" c:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                    <Image Source="{Binding LocalIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="2" Margin="18,0,16,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" FontSize="24" TextTrimming="CharacterEllipsis"/>
                    <Border Style="{StaticResource Badge}" Margin="12,4,0,0">
                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource BadgeText}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Author, StringFormat=by {0}}" Style="{StaticResource Muted}" Margin="0,3,0,0"
                           Visibility="{Binding Author, Converter={StaticResource VisibleIf}}"/>
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Fg2}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="3" VerticalAlignment="Top">
                <Button Command="{Binding OpenWebCommand}" Visibility="{Binding Details, Converter={StaticResource VisibleIf}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Open website"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Info chips -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Border Style="{StaticResource InfoChip}" Visibility="{Binding Details, Converter={StaticResource VisibleIf}}">
                <TextBlock><Run Text="Side  " Foreground="{StaticResource Fg3}"/><Run Text="{Binding Details.Side, Mode=OneWay}"/></TextBlock>
            </Border>
            <Border Style="{StaticResource InfoChip}" Visibility="{Binding Details, Converter={StaticResource VisibleIf}}">
                <TextBlock><Run Text="Loaders  " Foreground="{StaticResource Fg3}"/><Run Text="{Binding Details.LoadersText, Mode=OneWay}"/></TextBlock>
            </Border>
            <Border Style="{StaticResource InfoChip}" Visibility="{Binding Details, Converter={StaticResource VisibleIf}}">
                <TextBlock><Run Text="License  " Foreground="{StaticResource Fg3}"/><Run Text="{Binding Details.License, Mode=OneWay}"/></TextBlock>
            </Border>
            <Border Style="{StaticResource InfoChip}" Visibility="{Binding Details, Converter={StaticResource VisibleIf}}">
                <TextBlock><Run Text="Downloads  " Foreground="{StaticResource Fg3}"/><Run Text="{Binding Details.DownloadsText, Mode=OneWay}"/></TextBlock>
            </Border>
            <Border Style="{StaticResource InfoChip}" Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line2}"
                    Visibility="{Binding Installed, Converter={StaticResource VisibleIf}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,7,0" VerticalAlignment="Center"/>
                    <TextBlock><Run Text="Installed  " Foreground="{StaticResource Fg3}"/><Run Text="{Binding Installed.Version, Mode=OneWay}"/></TextBlock>
                    <Button Content="Remove" Padding="8,2" FontSize="11.5" Margin="10,-3,-6,-3" Command="{Binding UninstallCommand}"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Tabs -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource TabButton}" Content="Description" GroupName="ptab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=description}"
                             Visibility="{Binding IsLocalOnly, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>
                <RadioButton Style="{StaticResource TabButton}" GroupName="ptab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=gallery}"
                             Visibility="{Binding IsLocalOnly, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"
                             Content="{Binding GalleryTabText}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Versions" GroupName="ptab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=versions}"
                             Visibility="{Binding IsLocalOnly, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="File info" GroupName="ptab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=info}"
                             Visibility="{Binding Installed, Converter={StaticResource VisibleIf}}"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="3">
            <StackPanel VerticalAlignment="Top" Visibility="{Binding IsLoading, Converter={StaticResource VisibleIf}}">
                <ProgressBar IsIndeterminate="True"/>
            </StackPanel>
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource Fg2}" VerticalAlignment="Top"
                       Visibility="{Binding Error, Converter={StaticResource VisibleIf}}"/>

            <!-- Description -->
            <Border Background="{StaticResource Bg2}" CornerRadius="10" Padding="16,10,4,0" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tab}" Value="description">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Details}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <c:HtmlView Html="{Binding Details.BodyHtml}"/>
            </Border>

            <!-- Gallery -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tab}" Value="gallery">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <TextBlock Text="This project has no gallery images." Style="{StaticResource Muted}"
                               Visibility="{Binding Details.Gallery.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert, FallbackValue=Collapsed}"/>
                    <ItemsControl ItemsSource="{Binding Details.Gallery}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenImageCommand, ElementName=Self}" CommandParameter="{Binding}" Margin="0,0,12,12" Padding="0" Width="300">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" CornerRadius="10" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
                                                <StackPanel>
                                                    <Border Height="168" Background="{StaticResource Bg3}" CornerRadius="9,9,0,0" ClipToBounds="True">
                                                        <Image c:RemoteImage.DecodeWidth="600" c:RemoteImage.Url="{Binding Url}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" Margin="12,8" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding Title, Converter={StaticResource VisibleIf}}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Fg2}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Versions -->
            <Grid Margin="0,0,0,16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tab}" Value="versions">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,16,0">
                    <CheckBox DockPanel.Dock="Top" IsChecked="{Binding CompatibleOnly}" Content="{Binding CompatText}" Margin="2,0,0,10"/>
                    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Margin="0,0,0,8" Visibility="{Binding LoadingVersions, Converter={StaticResource VisibleIf}}"/>
                    <TextBlock DockPanel.Dock="Top" Text="No versions match this instance. Untick the filter to see all versions." Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Visibility="{Binding Versions.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" Margin="2,0,0,0"/>
                    <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="White" BorderBrush="White" VerticalAlignment="Top"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource VisibleIf}}">
                                        <TextBlock Text="Installed" Style="{StaticResource BadgeText}" Foreground="Black" FontWeight="SemiBold"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Version.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                                            <Run Text="{Binding Version.ReleaseType, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Version.DateText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Version.GameVersionsText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <Border Grid.Column="1" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                        Visibility="{Binding SelectedVersion, Converter={StaticResource VisibleIf}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding InstallText}" Command="{Binding InstallCommand}"
                                            IsEnabled="{Binding CanInstall}" MinWidth="150"/>
                                    <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource Faint}" Margin="0,6,0,0" HorizontalAlignment="Right" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding SelectedVersion.Version.Name}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding SelectedVersion.Version.VersionNumber, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SelectedVersion.Version.LoadersText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedVersion.Version.FileName}" Style="{StaticResource Faint}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="CHANGELOG" Style="{StaticResource Overline}" Margin="18,14,0,6"/>
                        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Margin="18,0,18,6" Visibility="{Binding LoadingChangelog, Converter={StaticResource VisibleIf}}"/>
                        <c:HtmlView Html="{Binding ChangelogHtml}" Margin="18,0,4,4"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Local file info -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tab}" Value="info">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource Card}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="FILE" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding Installed.FileName}" Margin="0,4,0,12"/>
                        <TextBlock Text="VERSION" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding Installed.Version, TargetNullValue='—'}" Margin="0,4,0,12"/>
                        <TextBlock Text="MOD ID" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding Installed.ModId, TargetNullValue='—'}" Margin="0,4,0,12"/>
                        <TextBlock Text="DESCRIPTION" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding Installed.Description, TargetNullValue='—'}" TextWrapping="Wrap" Margin="0,4,0,12" Foreground="{StaticResource Fg2}"/>
                        <TextBlock Text="LOCATION" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding Installed.FilePath}" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource Faint}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="This file wasn't found on Modrinth or CurseForge, so there's no project page or version list for it."
                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,12,0,0"
                           Visibility="{Binding IsLocalOnly, Converter={StaticResource VisibleIf}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
