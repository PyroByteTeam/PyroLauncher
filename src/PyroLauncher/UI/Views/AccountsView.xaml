<UserControl x:Class="PyroLauncher.UI.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:PyroLauncher.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PyroLauncher.UI.Controls"
             x:Name="Self">
    <Border Style="{StaticResource DialogCard}" Width="520">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" Command="{Binding CloseCommand}" ToolTip="{l:T 'Close'}" VerticalAlignment="Top" IsCancel="True"/>
                <StackPanel>
                    <TextBlock Text="{l:T 'Accounts'}" Style="{StaticResource H2}" FontSize="20"/>
                    <TextBlock Text="{l:T 'Choose who plays. Click an account to make it active.'}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Account list -->
            <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,18,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectCommand, ElementName=Self}" CommandParameter="{Binding}" Margin="0,0,0,8"
                                Padding="12,10" HorizontalContentAlignment="Stretch" x:Name="row">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="12" ToolTip="{l:T 'Remove'}"
                                        Command="{Binding DataContext.RemoveCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="0,0,8,0" Background="White" BorderBrush="White"
                                        Visibility="{Binding IsSelected, Converter={StaticResource VisibleIf}}">
                                    <TextBlock Text="{l:T 'Active'}" Style="{StaticResource BadgeText}" Foreground="Black" FontWeight="SemiBold"/>
                                </Border>
                                <Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource Bg4}" ClipToBounds="True" Margin="0,0,12,0">
                                    <Image c:RemoteImage.DecodeWidth="64" c:RemoteImage.Url="{Binding AvatarUrl}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding TypeText}" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Fg2}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{l:T 'No accounts yet.'}" Style="{StaticResource Faint}" Margin="0,4,0,4"
                       Visibility="{Binding HasAccounts, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>

            <Border Height="1" Background="{StaticResource Line}" Margin="0,16"/>

            <!-- Microsoft -->
            <TextBlock Text="{l:T 'MICROSOFT ACCOUNT'}" Style="{StaticResource Overline}"/>
            <Grid Margin="0,8,0,0">
                <Button Command="{Binding SignInMicrosoftCommand}" HorizontalAlignment="Left"
                        Visibility="{Binding IsSigningIn, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T 'Sign in with Microsoft'}"/>
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource Card}" Padding="16,14" Visibility="{Binding IsSigningIn, Converter={StaticResource VisibleIf}}">
                    <StackPanel>
                        <TextBlock Text="{Binding MsStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <StackPanel Visibility="{Binding DeviceCode, Converter={StaticResource VisibleIf}}" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                                <Run Text="{l:T 'Open'}"/> <Hyperlink Command="{Binding OpenVerificationCommand}" Foreground="White"><Run Text="{Binding DeviceCode.VerificationUri, Mode=OneWay}"/></Hyperlink>
                                <Run Text="{l:T 'and enter this code (already copied):'}"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="8" Padding="16,8">
                                    <TextBlock Text="{Binding DeviceCode.UserCode}" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold"/>
                                </Border>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="{l:T 'Copy code'}" Command="{Binding CopyCodeCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" Margin="0,14,0,0"/>
                        <Button Content="{l:T 'Cancel'}" Command="{Binding CancelSignInCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="{Binding MsError}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding MsError, Converter={StaticResource VisibleIf}}"/>

            <!-- Offline -->
            <TextBlock Text="{l:T 'OFFLINE ACCOUNT'}" Style="{StaticResource Overline}" Margin="0,20,0,0"/>
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="{l:T 'Add'}" Command="{Binding AddOfflineCommand}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding OfflineName, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T 'Player name'}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddOfflineCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <TextBlock Text="{Binding OfflineError}" Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding OfflineError, Converter={StaticResource VisibleIf}}"/>
            <TextBlock Text="{l:T 'Offline accounts can play singleplayer and offline-mode servers.'}" Style="{StaticResource Faint}" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
