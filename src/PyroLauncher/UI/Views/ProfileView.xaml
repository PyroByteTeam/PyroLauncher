<UserControl x:Class="PyroLauncher.UI.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PyroLauncher.UI.Controls"
             x:Name="Self">
    <Grid Margin="36,0,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Profile" Style="{StaticResource H1}"/>
            <TextBlock Text="Switch accounts, preview your skin and change capes." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ================= Accounts ================= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding AccountsVm}">
                <StackPanel x:Name="AccountsPanel">
                    <TextBlock Text="ACCOUNTS" Style="{StaticResource Overline}" Margin="2,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="row" Command="{Binding DataContext.SelectCommand, ElementName=AccountsPanel}" CommandParameter="{Binding}"
                                        Margin="0,0,0,8" Padding="10,9" HorizontalContentAlignment="Stretch">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE74D;" FontSize="11" ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveCommand, ElementName=AccountsPanel}" CommandParameter="{Binding}"/>
                                        <Border Width="34" Height="34" CornerRadius="7" Background="{StaticResource Bg4}" ClipToBounds="True" Margin="0,0,10,0">
                                            <Image c:RemoteImage.DecodeWidth="64" c:RemoteImage.Url="{Binding AvatarUrl}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TypeText}" Style="{StaticResource Faint}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Fg}"/>
                                        <Setter TargetName="row" Property="Background" Value="{StaticResource Bg4}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No accounts yet — add one below." Style="{StaticResource Muted}" Margin="2,0,0,8"
                               Visibility="{Binding HasAccounts, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>

                    <TextBlock Text="ADD MICROSOFT ACCOUNT" Style="{StaticResource Overline}" Margin="2,14,0,8"/>
                    <Button Command="{Binding SignInMicrosoftCommand}" HorizontalAlignment="Stretch"
                            Visibility="{Binding IsSigningIn, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sign in with Microsoft"/>
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource Card}" Padding="14,12" Visibility="{Binding IsSigningIn, Converter={StaticResource VisibleIf}}">
                        <StackPanel>
                            <TextBlock Text="{Binding MsStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <StackPanel Visibility="{Binding DeviceCode, Converter={StaticResource VisibleIf}}" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap">
                                    <Run Text="Enter this code at"/> <Hyperlink Command="{Binding OpenVerificationCommand}" Foreground="White"><Run Text="{Binding DeviceCode.VerificationUri, Mode=OneWay}"/></Hyperlink>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                        <TextBlock Text="{Binding DeviceCode.UserCode}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Bold"/>
                                    </Border>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy code" Command="{Binding CopyCodeCommand}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <ProgressBar IsIndeterminate="True" Margin="0,12,0,0"/>
                            <Button Content="Cancel" Command="{Binding CancelSignInCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding MsError}" TextWrapping="Wrap" Margin="2,8,0,0" Style="{StaticResource Muted}"
                               Visibility="{Binding MsError, Converter={StaticResource VisibleIf}}"/>

                    <TextBlock Text="ADD OFFLINE ACCOUNT" Style="{StaticResource Overline}" Margin="2,18,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddOfflineCommand}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding OfflineName, UpdateSourceTrigger=PropertyChanged}" Tag="Player name">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddOfflineCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <TextBlock Text="{Binding OfflineError}" Style="{StaticResource Muted}" Margin="2,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding OfflineError, Converter={StaticResource VisibleIf}}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 3D skin ================= -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.Background>
                        <RadialGradientBrush GradientOrigin="0.5,0.45" Center="0.5,0.45" RadiusX="0.7" RadiusY="0.6">
                            <GradientStop Color="#FF1E1E1E" Offset="0"/>
                            <GradientStop Color="#FF121212" Offset="1"/>
                        </RadialGradientBrush>
                    </Grid.Background>
                    <c:SkinViewer Skin="{Binding Skin}" Cape="{Binding CapeTexture}" Slim="{Binding Slim}" Margin="10,60,10,60"/>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,18,0,0" IsHitTestVisible="False">
                        <TextBlock Text="{Binding Account.Username, FallbackValue='No account'}" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0">
                            <Run Text="{Binding Account.TypeText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding VariantText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Style="{StaticResource Badge}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,18,18,0"
                            Visibility="{Binding HasPending, Converter={StaticResource VisibleIf}}" Background="White" BorderBrush="White">
                        <TextBlock Text="Preview — not uploaded" Style="{StaticResource BadgeText}" Foreground="Black" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="Drag to rotate" Style="{StaticResource Faint}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18" IsHitTestVisible="False"/>
                    <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Margin="0" Visibility="{Binding IsLoading, Converter={StaticResource VisibleIf}}"/>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="20,0,20,44"
                               HorizontalAlignment="Center" TextAlignment="Center" Visibility="{Binding Error, Converter={StaticResource VisibleIf}}"/>
                </Grid>
            </Border>

            <!-- ================= Wardrobe ================= -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                    <TextBlock Text="SKIN" Style="{StaticResource Overline}" Margin="2,0,0,10"/>
                    <StackPanel Visibility="{Binding IsMicrosoft, Converter={StaticResource VisibleIf}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Classic" GroupName="variant"
                                         IsChecked="{Binding UploadSlim, Converter={StaticResource Not}}"/>
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Slim" GroupName="variant" IsChecked="{Binding UploadSlim}"/>
                        </StackPanel>
                        <Button Command="{Binding ChooseSkinCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Choose skin file…"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Visibility="{Binding HasPending, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="{Binding PendingSkinPath}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="2,0,0,8"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelSkinCommand}" Margin="8,0,0,0"/>
                                <Button Content="Upload to Minecraft" Style="{StaticResource PrimaryButton}" Command="{Binding UploadSkinCommand}"/>
                            </DockPanel>
                        </StackPanel>
                        <Button Content="Reset to default skin" Style="{StaticResource GhostButton}" Command="{Binding ResetSkinCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Skins and capes can only be changed for Microsoft accounts. Offline accounts show the public skin for that name, if any."
                               Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Visibility="{Binding IsMicrosoft, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>

                    <TextBlock Text="CAPES" Style="{StaticResource Overline}" Margin="2,24,0,10" Visibility="{Binding IsMicrosoft, Converter={StaticResource VisibleIf}}"/>
                    <Border Visibility="{Binding IsMicrosoft, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="This account doesn't own any capes." Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Visibility="{Binding Capes.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" Margin="2,-4,0,0"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Capes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="cape" Width="88" Margin="0,0,8,8" Padding="6,8" ToolTip="{Binding Name}"
                                        Command="{Binding DataContext.SelectCapeCommand, ElementName=Self}" CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Border Width="40" Height="64" Background="{StaticResource Bg1}" CornerRadius="4" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Preview}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="cape" Property="BorderBrush" Value="{StaticResource Fg}"/>
                                        <Setter TargetName="cape" Property="Background" Value="{StaticResource Bg4}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ProgressBar IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}}"/>
                    <Button Content="Reload profile" Style="{StaticResource GhostButton}" Command="{Binding ReloadCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
