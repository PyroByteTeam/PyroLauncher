<UserControl x:Class="PyroLauncher.UI.Views.InstanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:PyroLauncher.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PyroLauncher.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left" Width="820">
                <!-- General -->
                <TextBlock Text="{l:T 'General'}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                <Border Style="{StaticResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T 'Name'}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T 'Category'}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}" Visibility="{Binding HasLoader, Converter={StaticResource VisibleIf}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding LoaderLabel}" FontWeight="SemiBold"/>
                            <TextBlock Text="{l:T 'Installed on next launch'}" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding LoaderVersion}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T 'Icon'}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource Bg3}" ClipToBounds="True" Margin="0,0,12,0">
                                <Grid>
                                    <TextBlock Text="{Binding Instance.Initial}" FontWeight="Bold" FontSize="18" Foreground="#FF4A4A4A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding Instance.Icon}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <Button Content="{l:T 'Change…'}" Command="{Binding ChangeIconCommand}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button Content="{l:T 'Remove'}" Command="{Binding RemoveIconCommand}" Style="{StaticResource GhostButton}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Game overrides -->
                <TextBlock Text="{l:T 'Game settings'}" Style="{StaticResource H2}" Margin="0,28,0,2"/>
                <TextBlock Text="{l:T 'Turn a setting on to override the global default from Settings → Minecraft for this instance only.'}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>

                <!-- Java -->
                <Border Style="{StaticResource SettingRow}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding UseJava}" Content="{l:T 'Custom'}"/>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Java executable'}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DefaultJava}" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0" Visibility="{Binding UseJava, Converter={StaticResource VisibleIf}}">
                            <Button DockPanel.Dock="Right" Content="{l:T 'Browse…'}" Command="{Binding BrowseJavaCommand}" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T 'C:\\Path\\to\\javaw.exe'}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Memory -->
                <Border Style="{StaticResource SettingRow}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding UseMemory}" Content="{l:T 'Custom'}"/>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Memory (RAM)'}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DefaultMemory}" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding UseMemory, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="{l:T 'MAXIMUM'}" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                            <c:MemoryPicker Value="{Binding MaxMemory}"/>
                            <TextBlock Text="{l:T 'MINIMUM'}" Style="{StaticResource Overline}" Margin="0,16,0,6"/>
                            <c:MemoryPicker Value="{Binding MinMemory}"/>
                            <TextBlock Text="{l:T '⚠  The minimum is higher than the maximum. The launcher will use the maximum for both when starting the game.'}" Foreground="{StaticResource LogWarn}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding MinAboveMax, Converter={StaticResource VisibleIf}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- JVM args -->
                <Border Style="{StaticResource SettingRow}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding UseJvmArgs}" Content="{l:T 'Custom'}"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T 'JVM arguments'}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DefaultJvm}" Style="{StaticResource Faint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBox Margin="0,10,0,0" Text="{Binding JvmArgs, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 TextWrapping="Wrap" AcceptsReturn="False" MinHeight="60" VerticalContentAlignment="Top"
                                 Visibility="{Binding UseJvmArgs, Converter={StaticResource VisibleIf}}"/>
                    </StackPanel>
                </Border>

                <!-- Resolution -->
                <Border Style="{StaticResource SettingRow}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding UseResolution}" Content="{l:T 'Custom'}"/>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Window size'}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DefaultResolution}" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding UseResolution, Converter={StaticResource VisibleIf}}">
                            <TextBox Width="100" Text="{Binding Width, Converter={StaticResource NullableInt}, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="×" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBox Width="100" Text="{Binding Height, Converter={StaticResource NullableInt}, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Fullscreen -->
                <Border Style="{StaticResource SettingRow}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding UseFullscreen}" Content="{l:T 'Custom'}"/>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Start in fullscreen'}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DefaultFullscreen}" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <CheckBox Margin="0,10,0,0" Content="{l:T 'Fullscreen'}" IsChecked="{Binding Fullscreen}" Visibility="{Binding UseFullscreen, Converter={StaticResource VisibleIf}}"/>
                    </StackPanel>
                </Border>

                <!-- Presets -->
                <TextBlock Text="{l:T 'Presets'}" Style="{StaticResource H2}" Margin="0,28,0,4"/>
                <Border Style="{StaticResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{l:T 'Apply a preset'}" FontWeight="SemiBold"/>
                            <TextBlock Text="{l:T 'Find the preset\'s mods, resource packs and shaders for this version and choose what to install.'}" Style="{StaticResource Faint}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button DockPanel.Dock="Right" Content="{l:T 'Manage presets'}" Command="{Binding ManagePresetsCommand}" Margin="8,0,0,0" Style="{StaticResource GhostButton}"/>
                            <Button DockPanel.Dock="Right" Command="{Binding ApplyPresetCommand}" Margin="8,0,0,0" IsEnabled="{Binding HasPresets}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{l:T 'Apply…'}"/>
                                </StackPanel>
                            </Button>
                            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" IsEnabled="{Binding HasPresets}"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Share -->
                <TextBlock Text="{l:T 'Share'}" Style="{StaticResource H2}" Margin="0,28,0,4"/>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding ExportCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:T 'Export modpack…'}"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{l:T 'Export as modpack'}" FontWeight="SemiBold"/>
                            <TextBlock Text="{l:T 'Save this instance as a Modrinth, CurseForge or PyroLauncher modpack and pick which files to include.'}" Style="{StaticResource Faint}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Danger -->
                <TextBlock Text="{l:T 'Manage'}" Style="{StaticResource H2}" Margin="0,28,0,4"/>
                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:T 'Open instance folder'}" Command="{Binding OpenFolderCommand}" Margin="0,0,10,0"/>
                        <Button Content="{l:T 'Delete instance…'}" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </Border>
                <Border Height="24"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Save bar -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{l:T 'Save changes'}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}"/>
                <TextBlock Text="{l:T 'You have unsaved changes.'}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                           Visibility="{Binding IsDirty, Converter={StaticResource VisibleIf}}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
