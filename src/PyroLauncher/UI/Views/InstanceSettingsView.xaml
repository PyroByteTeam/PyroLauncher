<UserControl x:Class="PyroLauncher.UI.Views.InstanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PyroLauncher.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left" Width="820">
                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                <Border Style="{StaticResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Category" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}" Visibility="{Binding HasLoader, Converter={StaticResource VisibleIf}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding LoaderLabel}" FontWeight="SemiBold"/>
                            <TextBlock Text="Installed on next launch" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding LoaderVersion}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Icon" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource Bg3}" ClipToBounds="True" Margin="0,0,12,0">
                                <Grid>
                                    <TextBlock Text="{Binding Instance.Initial}" FontWeight="Bold" FontSize="18" Foreground="#FF4A4A4A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding Instance.Icon}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <Button Content="Change…" Command="{Binding ChangeIconCommand}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button Content="Remove" Command="{Binding RemoveIconCommand}" Style="{StaticResource GhostButton}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Game overrides -->
                <TextBlock Text="Game settings" Style="{StaticResource H2}" Margin="0,28,0,2"/>
                <TextBlock Text="Turn a setting on to override the global default from Settings → Minecraft for this instance only." Style="{StaticResource Muted}" Margin="0,0,0,4"/>

                <!-- Java -->
                <Border Style="{StaticResource SettingRow}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding UseJava}" Content="Custom"/>
                            <StackPanel>
                                <TextBlock Text="Java executable" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DefaultJava}" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0" Visibility="{Binding UseJava, Converter={StaticResource VisibleIf}}">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseJavaCommand}" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" Tag="C:\Path\to\javaw.exe"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Memory -->
                <Border Style="{StaticResource SettingRow}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding UseMemory}" Content="Custom"/>
                            <StackPanel>
                                <TextBlock Text="Memory (RAM)" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DefaultMemory}" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding UseMemory, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="MAXIMUM" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                            <c:MemoryPicker Value="{Binding MaxMemory}"/>
                            <TextBlock Text="MINIMUM" Style="{StaticResource Overline}" Margin="0,16,0,6"/>
                            <c:MemoryPicker Value="{Binding MinMemory}"/>
                            <TextBlock Text="⚠  The minimum is higher than the maximum. The launcher will use the maximum for both when starting the game." Foreground="{StaticResource LogWarn}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding MinAboveMax, Converter={StaticResource VisibleIf}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- JVM args -->
                <Border Style="{StaticResource SettingRow}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding UseJvmArgs}" Content="Custom"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="JVM arguments" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DefaultJvm}" Style="{StaticResource Faint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBox Margin="0,10,0,0" Text="{Binding JvmArgs, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 TextWrapping="Wrap" AcceptsReturn="False" MinHeight="60" VerticalContentAlignment="Top"
                                 Visibility="{Binding UseJvmArgs, Converter={StaticResource VisibleIf}}"/>
                    </StackPanel>
                </Border>

                <!-- Resolution -->
                <Border Style="{StaticResource SettingRow}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding UseResolution}" Content="Custom"/>
                            <StackPanel>
                                <TextBlock Text="Window size" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DefaultResolution}" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding UseResolution, Converter={StaticResource VisibleIf}}">
                            <TextBox Width="100" Text="{Binding Width, Converter={StaticResource NullableInt}, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="×" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBox Width="100" Text="{Binding Height, Converter={StaticResource NullableInt}, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Fullscreen -->
                <Border Style="{StaticResource SettingRow}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding UseFullscreen}" Content="Custom"/>
                            <StackPanel>
                                <TextBlock Text="Start in fullscreen" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DefaultFullscreen}" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <CheckBox Margin="0,10,0,0" Content="Fullscreen" IsChecked="{Binding Fullscreen}" Visibility="{Binding UseFullscreen, Converter={StaticResource VisibleIf}}"/>
                    </StackPanel>
                </Border>

                <!-- Danger -->
                <TextBlock Text="Manage" Style="{StaticResource H2}" Margin="0,28,0,4"/>
                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open instance folder" Command="{Binding OpenFolderCommand}" Margin="0,0,10,0"/>
                        <Button Content="Delete instance…" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </Border>
                <Border Height="24"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Save bar -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Save changes" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}"/>
                <TextBlock Text="You have unsaved changes." Style="{StaticResource Muted}" VerticalAlignment="Center"
                           Visibility="{Binding IsDirty, Converter={StaticResource VisibleIf}}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
