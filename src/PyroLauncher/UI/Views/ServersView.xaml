<UserControl x:Class="PyroLauncher.UI.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding ShowAddCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add server"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Command="{Binding RefreshCommand}"/>
            </StackPanel>
            <TextBlock Text="Servers from this instance's servers.dat — the same list you see in Multiplayer." Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14" Visibility="{Binding IsAdding, Converter={StaticResource VisibleIf}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Cancel" Command="{Binding CancelAddCommand}" Margin="10,0,8,0"/>
                    <Button Content="Add" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NAME" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Tag="Minecraft Server"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ADDRESS" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}" Tag="play.example.com:25565"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="No servers saved yet." Style="{StaticResource Muted}" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleIf}}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,20">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="8" Background="{StaticResource Bg3}" ClipToBounds="True" Margin="0,0,14,0">
                                    <Grid>
                                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Address}" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Motd}" Style="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Motd, Converter={StaticResource VisibleIf}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse x:Name="dot" Width="7" Height="7" Fill="{StaticResource Fg3}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Ping}" Style="{StaticResource Faint}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy address" FontSize="12"
                                            Command="{Binding DataContext.CopyAddressCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove" FontSize="12"
                                            Command="{Binding DataContext.RemoveCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                <Setter TargetName="dot" Property="Fill" Value="White"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
