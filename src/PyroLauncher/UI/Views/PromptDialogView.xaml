<UserControl x:Class="PyroLauncher.UI.Views.PromptDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FocusManager.FocusedElement="{Binding ElementName=Input}">
    <Border Style="{StaticResource DialogCard}" Width="420">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
            <TextBlock Text="{Binding Label}" Style="{StaticResource Overline}" Margin="0,18,0,6"/>
            <TextBox x:Name="Input" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
