<UserControl x:Class="PyroLauncher.UI.Views.PresetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:PyroLauncher.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PyroLauncher.UI.Controls"
             x:Name="Self">
    <Grid Margin="36,0,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,18">
            <TextBlock Text="{l:T 'Presets'}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T 'Lists of mods, resource packs and shaders you can add to any instance in one go.'}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ===== Left: preset list ===== -->
        <DockPanel Grid.Row="1" Margin="0,0,18,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T 'New preset'}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding NewFromInstanceCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                        ToolTip="{l:T 'Start a preset with the mods, resource packs and shaders of an existing instance'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T 'From an instance…'}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{l:T 'No presets yet.'}" Style="{StaticResource Faint}" Margin="2,4,0,0"
                       Visibility="{Binding Presets.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>
            <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" FontSize="11.5"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===== Right: nothing selected ===== -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"
                Visibility="{Binding HasSelection, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{StaticResource Fg3}" HorizontalAlignment="Center"/>
                <TextBlock Text="{l:T 'Presets are lists of mods, resource packs and shaders'}" Style="{StaticResource H3}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,6"/>
                <TextBlock Text="{l:T 'Create one, fill it with projects, then apply it to an instance: the launcher finds versions that fit and lets you choose what to install.'}"
                           Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ===== Right: selected preset ===== -->
        <DockPanel Grid.Row="1" Grid.Column="1" Visibility="{Binding HasSelection, Converter={StaticResource VisibleIf}}">
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="pmode" Padding="14,7" Margin="0,0,6,0"
                                 IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=edit}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T 'Edit'}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="pmode" Padding="14,7" Margin="0,0,14,0"
                                 IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=apply}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T 'Apply to an instance'}"/>
                        </StackPanel>
                    </RadioButton>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8AC;" FontSize="12" Width="32" Height="32" ToolTip="{l:T 'Rename preset'}" Command="{Binding RenameCommand}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" FontSize="12" Width="32" Height="32" ToolTip="{l:T 'Duplicate preset'}" Command="{Binding DuplicateCommand}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="12" Width="32" Height="32" ToolTip="{l:T 'Delete preset'}" Command="{Binding DeleteCommand}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Selected.CountText}" Style="{StaticResource Faint}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <Grid>
                <!-- ===== Edit: contents + search ===== -->
                <Grid Visibility="{Binding IsEditMode, Converter={StaticResource VisibleIf}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,16,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{l:T 'Empty - add projects with the search on the right.'}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                       Visibility="{Binding Selected.Items.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert, FallbackValue=Collapsed}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <ItemsControl ItemsSource="{Binding Selected.ItemsView}">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Overline}" Margin="2,8,0,6"/>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="row" Background="{StaticResource Bg3}" CornerRadius="8" Padding="8,6" Margin="0,0,0,5">
                                                <DockPanel>
                                                    <Button x:Name="rm" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="26" Height="26"
                                                            ToolTip="{l:T 'Remove from preset'}" Visibility="Hidden"
                                                            Command="{Binding DataContext.RemoveItemCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                                                    <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource Bg4}" ClipToBounds="True" Margin="0,0,10,0">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image c:RemoteImage.DecodeWidth="60" c:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource Faint}" FontSize="11.5"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="rm" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="row" Property="Background" Value="{StaticResource Bg4}"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- search to add -->
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="{l:T 'Add to preset'}" Style="{StaticResource H3}" Margin="0,0,0,10"/>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SearchType}" ToolTip="{l:T 'What to search for'}"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" ToolTip="{l:T 'Where to search'}"/>
                        </Grid>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T 'Search projects'}" Padding="32,7,10,7"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Fg3}" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Margin="0,0,0,8" Visibility="{Binding Searching, Converter={StaticResource VisibleIf}}"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SearchError}" Foreground="{StaticResource Fg2}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding SearchError, Converter={StaticResource VisibleIf}}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="8,7" Margin="0,0,0,6">
                                            <DockPanel>
                                                <Button x:Name="add" DockPanel.Dock="Right" Padding="10,4" FontSize="12" VerticalAlignment="Center" Content="{l:T 'Add'}"
                                                        Command="{Binding DataContext.ToggleCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                                                <Border Width="34" Height="34" CornerRadius="7" Background="{StaticResource Bg4}" ClipToBounds="True" Margin="0,0,10,0">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image c:RemoteImage.DecodeWidth="68" c:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                                                    <TextBlock Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" FontSize="11.5">
                                                        <Run Text="{Binding DownloadsText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Author, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="add" Property="Content" Value="{l:T 'Added'}"/>
                                                <Setter TargetName="add" Property="Style" Value="{StaticResource PrimaryButton}"/>
                                                <Setter TargetName="add" Property="ToolTip" Value="{l:T 'Click to remove from the preset'}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- ===== Apply: pick an instance, choose what to install ===== -->
                <Border Style="{StaticResource Card}" Padding="18,16" Visibility="{Binding IsApplyMode, Converter={StaticResource VisibleIf}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="12" Width="34" Height="34" Margin="8,0,0,0"
                                    ToolTip="{l:T 'Check again'}" Command="{Binding RefreshApplyCommand}" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Left" Text="{l:T 'Instance'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding TargetInstance}" IsEnabled="{Binding HasInstances}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="22" Height="22" CornerRadius="5" Background="{StaticResource Bg4}" ClipToBounds="True" Margin="0,0,10,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource Fg2}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <Grid>
                            <TextBlock Text="{l:T 'There are no instances yet.'}" Style="{StaticResource Muted}"
                                       Visibility="{Binding HasInstances, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>
                            <TextBlock Text="{l:T 'This preset is empty - add projects on the Edit tab first.'}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Selected.Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ContentControl Content="{Binding Apply}" Focusable="False"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
