<UserControl x:Class="PyroLauncher.UI.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <Grid Margin="36,0,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Pause all" Command="{Binding PauseAllCommand}" Margin="0,0,8,0"/>
                <Button Content="Resume all" Command="{Binding ResumeAllCommand}" Margin="0,0,8,0"/>
                <Button Content="Clear finished" Command="{Binding ClearFinishedCommand}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Downloads" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                    <Run Text="{Binding Summary.ActiveCount, Mode=OneWay}"/><Run Text=" active"/>
                    <Run Text="{Binding Summary.Text, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Jobs -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="TASKS" Style="{StaticResource Overline}" Margin="2,0,0,10"/>
                <TextBlock DockPanel.Dock="Top" Text="Nothing has been downloaded yet in this session." Style="{StaticResource Muted}"
                           Visibility="{Binding Jobs.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,20">
                    <ItemsControl ItemsSource="{Binding Jobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="card" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsActive, Converter={StaticResource VisibleIf}}">
                                                <Button Content="Pause" Margin="0,0,6,0" Padding="12,5"
                                                        Command="{Binding DataContext.PauseCommand, ElementName=Self}" CommandParameter="{Binding}"
                                                        Visibility="{Binding IsPaused, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>
                                                <Button Content="Resume" Margin="0,0,6,0" Padding="12,5" Style="{StaticResource PrimaryButton}"
                                                        Command="{Binding DataContext.ResumeCommand, ElementName=Self}" CommandParameter="{Binding}"
                                                        Visibility="{Binding IsPaused, Converter={StaticResource VisibleIf}}"/>
                                                <Button Content="Cancel" Padding="12,5" Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.CancelCommand, ElementName=Self}" CommandParameter="{Binding}"
                                                        Visibility="{Binding CanCancel, Converter={StaticResource VisibleIf}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"/>
                                                <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource BadgeText}"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>
                                        <ProgressBar Margin="0,12,0,8" Height="4" Value="{Binding Progress, Converter={StaticResource Percent}, Mode=OneWay}"
                                                     IsIndeterminate="{Binding Progress, Converter={StaticResource Indeterminate}, Mode=OneWay}"/>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedText}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                            <TextBlock Style="{StaticResource Muted}">
                                                <Run Text="{Binding FilesText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding BytesText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding CurrentFile}" Style="{StaticResource Faint}" FontFamily="{StaticResource MonoFont}" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" Visibility="{Binding CurrentFile, Converter={StaticResource VisibleIf}}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter TargetName="card" Property="Opacity" Value="0.6"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Hosts -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="CONNECTED SERVERS" Style="{StaticResource Overline}" Margin="2,0,0,10"/>
                <Border Style="{StaticResource Card}" Padding="0,6" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="16,6,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Domain" Style="{StaticResource Faint}"/>
                            <TextBlock Grid.Column="1" Text="Active" Style="{StaticResource Faint}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="Received" Style="{StaticResource Faint}" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="No connections yet." Style="{StaticResource Muted}" Margin="16,0,16,8"
                                   Visibility="{Binding Hosts.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>
                        <ItemsControl ItemsSource="{Binding Hosts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,5" ToolTip="{Binding Requests, StringFormat={}{0} requests}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="dot" Width="6" Height="6" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Host}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Active}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{Binding BytesText}" HorizontalAlignment="Right" Style="{StaticResource Muted}"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Active}" Value="0">
                                            <Setter TargetName="dot" Property="Opacity" Value="0.25"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
