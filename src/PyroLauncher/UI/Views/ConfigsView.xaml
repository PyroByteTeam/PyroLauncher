<UserControl x:Class="PyroLauncher.UI.Views.ConfigsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:PyroLauncher.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,80" MaxWidth="440">
            <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Fg2}"/>
            </Border>
            <TextBlock Text="{l:T 'Config editor - coming soon'}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
            <TextBlock Text="{l:T 'Browse and edit mod configuration files right inside the launcher. Until then you can open the config folder directly.'}"
                       Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button Content="{l:T 'Open config folder'}" Command="{Binding OpenConfigFolderCommand}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
