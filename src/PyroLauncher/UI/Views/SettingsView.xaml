<UserControl x:Class="PyroLauncher.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="36,0,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <TextBlock Text="Changes are saved automatically." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,0,16,18">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource TabButton}" Content="Launcher" Tag="&#xE8B7;" GroupName="stab" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=launcher}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Minecraft (all instances)" Tag="&#xE7FC;" GroupName="stab" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=minecraft}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,16,24">
            <Grid>
                <!-- ================= Launcher ================= -->
                <StackPanel Width="820" HorizontalAlignment="Left">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Section}" Value="launcher">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Accounts &amp; services" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="Microsoft client ID" Style="{StaticResource RowTitle}"/>
                            <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,3,0,8">
                                <Run Text="Application (client) ID of an Azure app registration with personal Microsoft accounts and the public client flow enabled, approved for the Minecraft API. Needed for Microsoft sign-in."/>
                                <Hyperlink Foreground="White" Command="{Binding OpenUrlCommand}" CommandParameter="https://aka.ms/mce-reviewappid">How to get one</Hyperlink>
                            </TextBlock>
                            <TextBox Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}" Tag="00000000-0000-0000-0000-000000000000" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="CurseForge API key" Style="{StaticResource RowTitle}"/>
                            <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,3,0,8">
                                <Run Text="Enables CurseForge search, mod pages and CurseForge modpack import. Get a free key from the"/>
                                <Hyperlink Foreground="White" Command="{Binding OpenUrlCommand}" CommandParameter="https://console.curseforge.com/">CurseForge console</Hyperlink><Run Text="."/>
                            </TextBlock>
                            <TextBox Text="{Binding CurseForgeApiKey, UpdateSourceTrigger=PropertyChanged}" Tag="$2a$10$…" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Behaviour" Style="{StaticResource H2}" Margin="0,28,0,4"/>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="When the game starts" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="The launcher keeps tracking play time in every mode." Style="{StaticResource Faint}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LaunchOptions}" SelectedItem="{Binding OnLaunch}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding OpenConsoleOnLaunch}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Open the game console on launch" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="A color-coded live log window for the launched instance. You can always open it from the instance page." Style="{StaticResource Faint}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Parallel downloads" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="How many files are downloaded at once (1–64)." Style="{StaticResource Faint}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding ConcurrentDownloads, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Java runtimes" Style="{StaticResource H2}" Margin="0,28,0,2"/>
                    <TextBlock Text="Eclipse Temurin builds from Adoptium, downloaded automatically when an instance needs them." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding JavaRuntimes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="12" ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveJavaCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                                        <Border Style="{StaticResource Badge}" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Major, StringFormat=Java {0}}" Style="{StaticResource BadgeText}" Foreground="{StaticResource Fg}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="{Binding InstallingJava, Converter={StaticResource Not}}">
                        <TextBlock Text="Install:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Java 8" Command="{Binding InstallJavaCommand}" CommandParameter="8" Margin="0,0,6,0"/>
                        <Button Content="Java 17" Command="{Binding InstallJavaCommand}" CommandParameter="17" Margin="0,0,6,0"/>
                        <Button Content="Java 21" Command="{Binding InstallJavaCommand}" CommandParameter="21" Margin="0,0,6,0"/>
                        <Button Content="Java 25" Command="{Binding InstallJavaCommand}" CommandParameter="25"/>
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding InstallingJava, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="{Binding JavaStatus}" Style="{StaticResource Muted}"/>
                        <ProgressBar IsIndeterminate="True" Margin="0,6,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Storage" Style="{StaticResource H2}" Margin="0,28,0,4"/>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open folder" Command="{Binding OpenDataFolderCommand}"/>
                            <StackPanel>
                                <TextBlock Text="Launcher data" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Faint}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Minecraft ================= -->
                <StackPanel Width="820" HorizontalAlignment="Left">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Section}" Value="minecraft">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="These defaults apply to every instance unless the instance overrides them in its own Settings tab." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="Java executable" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Leave empty to pick the right Java version automatically (recommended)." Style="{StaticResource Faint}" Margin="0,3,0,8"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseJavaCommand}" Margin="8,0,0,0"/>
                                <TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" Tag="Automatic (Adoptium)"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="Memory" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="{Binding SystemMemory}" Style="{StaticResource Faint}" Margin="0,3,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Min" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="110" Text="{Binding MinMemory, Converter={StaticResource Memory}, UpdateSourceTrigger=LostFocus}" ToolTip="Type MB, or GB as 1, 2, 4, 8… — snapped to a power of two"/>
                                <TextBlock Text="{Binding MinMemory, Converter={StaticResource MbToGb}}" Style="{StaticResource Faint}" VerticalAlignment="Center" Margin="8,0,24,0" MinWidth="60"/>
                                <TextBlock Text="Max" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="110" Text="{Binding MaxMemory, Converter={StaticResource Memory}, UpdateSourceTrigger=LostFocus}" ToolTip="Type MB, or GB as 1, 2, 4, 8… — snapped to a power of two"/>
                                <TextBlock Text="{Binding MaxMemory, Converter={StaticResource MbToGb}}" Style="{StaticResource Faint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource GhostButton}" Command="{Binding ResetJvmArgsCommand}"/>
                                <StackPanel>
                                    <TextBlock Text="JVM arguments" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Extra flags passed to Java (memory flags are added separately)." Style="{StaticResource Faint}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBox Margin="0,8,0,0" Text="{Binding JvmArgs, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="Window size" Style="{StaticResource RowTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox Width="100" Text="{Binding Width, Converter={StaticResource NullableInt}, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="×" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0"/>
                                <TextBox Width="100" Text="{Binding Height, Converter={StaticResource NullableInt}, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Fullscreen}"/>
                            <StackPanel>
                                <TextBlock Text="Start in fullscreen" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Passes --fullscreen to the game." Style="{StaticResource Faint}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
