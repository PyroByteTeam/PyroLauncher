<UserControl x:Class="PyroLauncher.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PyroLauncher.UI.Controls"
             x:Name="Self">
    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- ===== Layout preview mockups (shown as hover hints) ===== -->
        <SolidColorBrush x:Key="MockFg" Color="#FF3C3C3C"/>
        <SolidColorBrush x:Key="MockHi" Color="#FFE8E8E8"/>
        <Style x:Key="MockFrame" TargetType="Border">
            <Setter Property="Width" Value="236"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Background" Value="#FF101010"/>
            <Setter Property="BorderBrush" Value="#FF2E2E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="MockBar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MockFg}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="MockCard" TargetType="Border">
            <Setter Property="Background" Value="#FF1C1C1C"/>
            <Setter Property="BorderBrush" Value="#FF2E2E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
        </Style>

        <StackPanel x:Key="PreviewTopNav" x:Shared="False">
            <TextBlock Text="Top navigation" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Style="{StaticResource MockFrame}">
                <StackPanel>
                    <Border Style="{StaticResource MockBar}" Width="90" Height="8" Background="{StaticResource MockHi}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource MockBar}" Width="24" Background="{StaticResource MockHi}"/>
                            <Border Height="2" Background="{StaticResource MockHi}" Margin="0,3,0,0" Width="24"/>
                        </StackPanel>
                        <Border Style="{StaticResource MockBar}" Width="34" Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <Border Style="{StaticResource MockBar}" Width="24" Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <Border Style="{StaticResource MockBar}" Width="30" Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <Border Style="{StaticResource MockBar}" Width="20" VerticalAlignment="Top"/>
                    </StackPanel>
                    <Border Height="1" Background="#FF2E2E2E" Margin="0,4,0,8"/>
                    <Border Style="{StaticResource MockCard}" Height="16" Margin="0,0,0,5"/>
                    <Border Style="{StaticResource MockCard}" Height="16" Margin="0,0,0,5"/>
                    <Border Style="{StaticResource MockCard}" Height="16" Margin="0,0,0,5"/>
                    <Border Style="{StaticResource MockCard}" Height="16" Margin="0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Sections are tabs across the top of the instance page." Style="{StaticResource Faint}" Margin="0,6,0,0" Width="236" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel x:Key="PreviewGridMenu" x:Shared="False">
            <TextBlock Text="Grid" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Style="{StaticResource MockFrame}">
                <StackPanel>
                    <Border Style="{StaticResource MockBar}" Width="90" Height="8" Background="{StaticResource MockHi}" Margin="0,0,0,10"/>
                    <UniformGrid Columns="3" Rows="2" Height="104">
                        <Border Style="{StaticResource MockCard}"><StackPanel Margin="5"><Border Style="{StaticResource MockBar}" Width="30" Background="{StaticResource MockHi}"/><WrapPanel Margin="0,6,0,0"><Ellipse Width="6" Height="6" Fill="#FF6A6A6A" Margin="0,0,2,2"/><Ellipse Width="6" Height="6" Fill="#FF6A6A6A" Margin="0,0,2,2"/><Ellipse Width="6" Height="6" Fill="#FF6A6A6A" Margin="0,0,2,2"/><Ellipse Width="6" Height="6" Fill="#FF6A6A6A" Margin="0,0,2,2"/><Ellipse Width="6" Height="6" Fill="#FF6A6A6A" Margin="0,0,2,2"/></WrapPanel></StackPanel></Border>
                        <Border Style="{StaticResource MockCard}"><StackPanel Margin="5"><Border Style="{StaticResource MockBar}" Width="36" Background="{StaticResource MockHi}"/><WrapPanel Margin="0,6,0,0"><Ellipse Width="6" Height="6" Fill="#FF6A6A6A" Margin="0,0,2,2"/><Ellipse Width="6" Height="6" Fill="#FF6A6A6A" Margin="0,0,2,2"/></WrapPanel></StackPanel></Border>
                        <Border Style="{StaticResource MockCard}"><StackPanel Margin="5"><Border Style="{StaticResource MockBar}" Width="26" Background="{StaticResource MockHi}"/></StackPanel></Border>
                        <Border Style="{StaticResource MockCard}"><StackPanel Margin="5"><Border Style="{StaticResource MockBar}" Width="32" Background="{StaticResource MockHi}"/></StackPanel></Border>
                        <Border Style="{StaticResource MockCard}"><StackPanel Margin="5"><Border Style="{StaticResource MockBar}" Width="24" Background="{StaticResource MockHi}"/></StackPanel></Border>
                        <Border Style="{StaticResource MockCard}"><StackPanel Margin="5"><Border Style="{StaticResource MockBar}" Width="28" Background="{StaticResource MockHi}"/></StackPanel></Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <TextBlock Text="An overview of section cards; drag them to rearrange." Style="{StaticResource Faint}" Margin="0,6,0,0" Width="236" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel x:Key="PreviewList" x:Shared="False">
            <TextBlock Text="List" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Style="{StaticResource MockFrame}">
                <StackPanel>
                    <Border Style="{StaticResource MockCard}" Height="22" Margin="0,0,0,6"><StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center"><Border Width="12" Height="7" CornerRadius="3.5" Background="{StaticResource MockHi}" Margin="0,0,6,0"/><Border Width="12" Height="12" CornerRadius="2" Background="#FF6A6A6A" Margin="0,0,6,0"/><Border Style="{StaticResource MockBar}" Width="80"/></StackPanel></Border>
                    <Border Style="{StaticResource MockCard}" Height="22" Margin="0,0,0,6"><StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center"><Border Width="12" Height="7" CornerRadius="3.5" Background="{StaticResource MockHi}" Margin="0,0,6,0"/><Border Width="12" Height="12" CornerRadius="2" Background="#FF6A6A6A" Margin="0,0,6,0"/><Border Style="{StaticResource MockBar}" Width="110"/></StackPanel></Border>
                    <Border Style="{StaticResource MockCard}" Height="22" Margin="0,0,0,6"><StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center"><Border Width="12" Height="7" CornerRadius="3.5" Background="#FF3C3C3C" Margin="0,0,6,0"/><Border Width="12" Height="12" CornerRadius="2" Background="#FF6A6A6A" Margin="0,0,6,0"/><Border Style="{StaticResource MockBar}" Width="64"/></StackPanel></Border>
                    <Border Style="{StaticResource MockCard}" Height="22" Margin="0,0,0,6"><StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center"><Border Width="12" Height="7" CornerRadius="3.5" Background="{StaticResource MockHi}" Margin="0,0,6,0"/><Border Width="12" Height="12" CornerRadius="2" Background="#FF6A6A6A" Margin="0,0,6,0"/><Border Style="{StaticResource MockBar}" Width="96"/></StackPanel></Border>
                </StackPanel>
            </Border>
            <TextBlock Text="Detailed rows with switch, name, version and source." Style="{StaticResource Faint}" Margin="0,6,0,0" Width="236" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel x:Key="PreviewGridList" x:Shared="False">
            <TextBlock Text="Grid" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Style="{StaticResource MockFrame}">
                <UniformGrid Columns="6" Rows="3">
                    <Border Style="{StaticResource MockCard}"><Border Width="14" Height="14" CornerRadius="3" Background="#FF6A6A6A"/></Border>
                    <Border Style="{StaticResource MockCard}"><Border Width="14" Height="14" CornerRadius="3" Background="#FF8A8A8A"/></Border>
                    <Border Style="{StaticResource MockCard}"><Border Width="14" Height="14" CornerRadius="3" Background="#FF6A6A6A"/></Border>
                    <Border Style="{StaticResource MockCard}"><Border Width="14" Height="14" CornerRadius="3" Background="#FF5A5A5A"/></Border>
                    <Border Style="{StaticResource MockCard}"><Border Width="14" Height="14" CornerRadius="3" Background="#FF6A6A6A"/></Border>
                    <Border Style="{StaticResource MockCard}"><Border Width="14" Height="14" CornerRadius="3" Background="#FF8A8A8A"/></Border>
                    <Border Style="{StaticResource MockCard}"><Border Width="14" Height="14" CornerRadius="3" Background="#FF5A5A5A"/></Border>
                    <Border Style="{StaticResource MockCard}"><Border Width="14" Height="14" CornerRadius="3" Background="#FF6A6A6A"/></Border>
                    <Border Style="{StaticResource MockCard}"><Border Width="14" Height="14" CornerRadius="3" Background="#FF8A8A8A"/></Border>
                    <Border Style="{StaticResource MockCard}"><Border Width="14" Height="14" CornerRadius="3" Background="#FF6A6A6A"/></Border>
                    <Border Style="{StaticResource MockCard}"><Border Width="14" Height="14" CornerRadius="3" Background="#FF5A5A5A"/></Border>
                    <Border Style="{StaticResource MockCard}"><Border Width="14" Height="14" CornerRadius="3" Background="#FF6A6A6A"/></Border>
                    <Border Style="{StaticResource MockCard}"><Border Width="14" Height="14" CornerRadius="3" Background="#FF8A8A8A"/></Border>
                    <Border Style="{StaticResource MockCard}"><Border Width="14" Height="14" CornerRadius="3" Background="#FF6A6A6A"/></Border>
                </UniformGrid>
            </Border>
            <TextBlock Text="Compact icon tiles (or two letters when there's no icon)." Style="{StaticResource Faint}" Margin="0,6,0,0" Width="236" TextWrapping="Wrap"/>
        </StackPanel>

        <Style x:Key="PreviewHint" TargetType="RadioButton" BasedOn="{StaticResource SegmentButton}">
            <Setter Property="ToolTipService.Placement" Value="Right"/>
            <Setter Property="ToolTipService.HorizontalOffset" Value="12"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <Style x:Key="Section" TargetType="StackPanel">
            <Setter Property="Width" Value="820"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="36,0,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <TextBlock Text="Changes are saved automatically." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,0,16,18">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource TabButton}" Content="Launcher" Tag="&#xE8B7;" GroupName="stab" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=launcher}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Appearance" Tag="&#xE790;" GroupName="stab" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=appearance}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Minecraft (all instances)" Tag="&#xE7FC;" GroupName="stab" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=minecraft}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,16,24">
            <Grid>
                <!-- ================= Launcher ================= -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource Section}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Section}" Value="launcher"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Services" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="CurseForge API key" Style="{StaticResource RowTitle}"/>
                            <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,3,0,8">
                                <Run Text="Enables CurseForge search, mod pages and CurseForge modpack import. Get a free key from the"/>
                                <Hyperlink Foreground="White" Command="{Binding OpenUrlCommand}" CommandParameter="https://console.curseforge.com/">CurseForge console</Hyperlink><Run Text="."/>
                            </TextBlock>
                            <TextBox Text="{Binding CurseForgeApiKey, UpdateSourceTrigger=PropertyChanged}" Tag="$2a$10$…" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Parallel downloads" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="How many files are downloaded at once (1–64)." Style="{StaticResource Faint}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding ConcurrentDownloads, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Java runtimes" Style="{StaticResource H2}" Margin="0,28,0,2"/>
                    <TextBlock Text="Eclipse Temurin builds from Adoptium, downloaded automatically when an instance needs them." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding JavaRuntimes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="12" ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveJavaCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                                        <Border Style="{StaticResource Badge}" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Major, StringFormat=Java {0}}" Style="{StaticResource BadgeText}" Foreground="{StaticResource Fg}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="{Binding InstallingJava, Converter={StaticResource Not}}">
                        <TextBlock Text="Install:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Java 8" Command="{Binding InstallJavaCommand}" CommandParameter="8" Margin="0,0,6,0"/>
                        <Button Content="Java 17" Command="{Binding InstallJavaCommand}" CommandParameter="17" Margin="0,0,6,0"/>
                        <Button Content="Java 21" Command="{Binding InstallJavaCommand}" CommandParameter="21" Margin="0,0,6,0"/>
                        <Button Content="Java 25" Command="{Binding InstallJavaCommand}" CommandParameter="25"/>
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding InstallingJava, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="{Binding JavaStatus}" Style="{StaticResource Muted}"/>
                        <ProgressBar IsIndeterminate="True" Margin="0,6,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Advanced" Style="{StaticResource H2}" Margin="0,28,0,4"/>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding DeveloperMode}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Developer mode" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Unlocks offline accounts for testing. Without it, only Microsoft accounts can be added and used." Style="{StaticResource Faint}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open folder" Command="{Binding OpenDataFolderCommand}"/>
                            <StackPanel>
                                <TextBlock Text="Launcher data" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Faint}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Appearance ================= -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource Section}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Section}" Value="appearance"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Layout" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource PreviewHint}" Content="Top navigation" GroupName="menu" ToolTip="{StaticResource PreviewTopNav}"
                                             IsChecked="{Binding InstanceMenuStyle, Converter={StaticResource Eq}, ConverterParameter=TopNavigation}"/>
                                <RadioButton Style="{StaticResource PreviewHint}" Content="Grid" GroupName="menu" Margin="0" ToolTip="{StaticResource PreviewGridMenu}"
                                             IsChecked="{Binding InstanceMenuStyle, Converter={StaticResource Eq}, ConverterParameter=Grid}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Instance menu" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Tabs across the top, or an overview grid of section cards you can drag to rearrange." Style="{StaticResource Faint}" Margin="0,3,16,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource PreviewHint}" Content="List" GroupName="list" ToolTip="{StaticResource PreviewList}"
                                             IsChecked="{Binding ContentListStyle, Converter={StaticResource Eq}, ConverterParameter=List}"/>
                                <RadioButton Style="{StaticResource PreviewHint}" Content="Grid" GroupName="list" Margin="0" ToolTip="{StaticResource PreviewGridList}"
                                             IsChecked="{Binding ContentListStyle, Converter={StaticResource Eq}, ConverterParameter=Grid}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Mod list style" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="How mods, resource packs and shader packs are listed: detailed rows or a grid of icons." Style="{StaticResource Faint}" Margin="0,3,16,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Behaviour" Style="{StaticResource H2}" Margin="0,28,0,4"/>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="When the game starts" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="The launcher keeps tracking play time in every mode." Style="{StaticResource Faint}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LaunchOptions}" SelectedItem="{Binding OnLaunch}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding OpenConsoleOnLaunch}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Separate game console window" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Opens a live log window when a game starts or crashes. When off, logs are only shown on the instance's Logs page." Style="{StaticResource Faint}" Margin="0,3,16,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Minecraft ================= -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource Section}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Section}" Value="minecraft"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="These defaults apply to every instance unless the instance overrides them in its own Settings tab." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="Maximum memory" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="{Binding SystemMemory}" Style="{StaticResource Faint}" Margin="0,3,0,10"/>
                            <c:MemoryPicker Value="{Binding MaxMemory}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="Minimum memory" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Memory reserved at start-up. Usually far below the maximum." Style="{StaticResource Faint}" Margin="0,3,0,10"/>
                            <c:MemoryPicker Value="{Binding MinMemory}"/>
                            <TextBlock Text="⚠  The minimum is higher than the maximum. The launcher will use the maximum for both when starting the game." Foreground="{StaticResource LogWarn}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding MinAboveMax, Converter={StaticResource VisibleIf}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="Java executable" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Leave empty to pick the right Java version automatically (recommended)." Style="{StaticResource Faint}" Margin="0,3,0,8"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseJavaCommand}" Margin="8,0,0,0"/>
                                <TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" Tag="Automatic (Adoptium)"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource GhostButton}" Command="{Binding ResetJvmArgsCommand}"/>
                                <StackPanel>
                                    <TextBlock Text="JVM arguments" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Extra flags passed to Java (memory flags are added separately)." Style="{StaticResource Faint}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBox Margin="0,8,0,0" Text="{Binding JvmArgs, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="Window size" Style="{StaticResource RowTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox Width="100" Text="{Binding Width, Converter={StaticResource NullableInt}, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="×" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0"/>
                                <TextBox Width="100" Text="{Binding Height, Converter={StaticResource NullableInt}, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Fullscreen}"/>
                            <StackPanel>
                                <TextBlock Text="Start in fullscreen" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Passes --fullscreen to the game." Style="{StaticResource Faint}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
