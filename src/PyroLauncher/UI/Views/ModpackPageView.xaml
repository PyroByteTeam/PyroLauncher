<UserControl x:Class="PyroLauncher.UI.Views.ModpackPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:PyroLauncher.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PyroLauncher.UI.Controls"
             x:Name="Self">
    <UserControl.Resources>
        <Style x:Key="InfoRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <Style x:Key="InfoKey" TargetType="TextBlock" BasedOn="{StaticResource Faint}">
            <Setter Property="Width" Value="96"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>
        <Style x:Key="InfoVal" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <!-- Discover page gets the page margins; inside an instance the instance page provides them -->
                    <DataTrigger Binding="{Binding IsDiscoverMode}" Value="True">
                        <Setter Property="Margin" Value="36,0,36,0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Header (Discover only) ===== -->
        <Grid Grid.ColumnSpan="2" Margin="0,0,0,18" Visibility="{Binding IsDiscoverMode, Converter={StaticResource VisibleIf}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{Binding BackCommand}" ToolTip="{l:T 'Back to Discover'}"
                    VerticalAlignment="Top" Margin="-8,0,10,0"/>
            <Border Grid.Column="1" Width="84" Height="84" CornerRadius="14" Background="{StaticResource Bg3}" ClipToBounds="True">
                <Image c:RemoteImage.DecodeWidth="168" c:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="2" Margin="20,2,20,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis"/>
                    <Border Style="{StaticResource Badge}" Margin="12,4,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource BadgeText}"/>
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="{Binding Author, Converter={StaticResource VisibleIf}}">
                    <Run Text="{l:T 'by'}"/> <Run Text="{Binding Author, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Fg2}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="{l:T 'Open website'}" Command="{Binding OpenWebCommand}" VerticalAlignment="Top"/>
        </Grid>

        <!-- ===== Main: tabs ===== -->
        <Grid Grid.Row="1" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TabButton}" Content="{l:T 'Description'}" Tag="&#xE8A5;" GroupName="mptab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=description}"/>
                    <RadioButton Style="{StaticResource TabButton}" Content="{Binding GalleryTabText}" Tag="&#xEB9F;" GroupName="mptab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=gallery}"/>
                    <RadioButton Style="{StaticResource TabButton}" Content="{l:T 'Versions'}" Tag="&#xE81C;" GroupName="mptab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=versions}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Top" Visibility="{Binding IsLoading, Converter={StaticResource VisibleIf}}">
                    <ProgressBar IsIndeterminate="True"/>
                </StackPanel>
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource Fg2}" VerticalAlignment="Top"
                           Visibility="{Binding Error, Converter={StaticResource VisibleIf}}"/>

                <!-- Description -->
                <Border Background="{StaticResource Bg2}" CornerRadius="10" Padding="16,10,4,0" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tab}" Value="description">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Details}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <c:HtmlView Html="{Binding Details.BodyHtml}"/>
                </Border>

                <!-- Gallery -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tab}" Value="gallery">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Text="{l:T 'This modpack has no gallery images.'}" Style="{StaticResource Muted}"
                                   Visibility="{Binding Details.Gallery.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert, FallbackValue=Collapsed}"/>
                        <ItemsControl ItemsSource="{Binding Details.Gallery}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenImageCommand, ElementName=Self}" CommandParameter="{Binding}" Margin="0,0,12,12" Padding="0" Width="300"
                                            ToolTip="{Binding Title}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" CornerRadius="10" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
                                                    <StackPanel>
                                                        <Border Height="168" Background="{StaticResource Bg3}" CornerRadius="9,9,0,0" ClipToBounds="True">
                                                            <Image c:RemoteImage.DecodeWidth="600" c:RemoteImage.Url="{Binding Url}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" Margin="12,8" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding Title, Converter={StaticResource VisibleIf}}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Fg2}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Versions -->
                <Grid Margin="0,0,0,16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tab}" Value="versions">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="140"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <CheckBox DockPanel.Dock="Top" IsChecked="{Binding ReleasesOnly}" Content="{l:T 'Releases only (hide betas and alphas)'}" Margin="2,0,0,10"/>
                        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Margin="0,0,0,8" Visibility="{Binding LoadingVersions, Converter={StaticResource VisibleIf}}"/>
                        <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="White" BorderBrush="White" VerticalAlignment="Top"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource VisibleIf}}">
                                            <TextBlock Text="{l:T 'Installed'}" Style="{StaticResource BadgeText}" Foreground="Black" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Version.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                                                <Run Text="{Binding Version.ReleaseType, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Version.DateText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Version.GameVersionsText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <Border Grid.Row="1" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                            Visibility="{Binding SelectedVersion, Converter={StaticResource VisibleIf}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,14">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding ActionText}" Command="{Binding ActCommand}"
                                            IsEnabled="{Binding CanAct}" MinWidth="150" VerticalAlignment="Center"/>
                                    <Button Command="{Binding ServerPackCommand}" IsEnabled="{Binding HasServerPack}" ToolTip="{Binding ServerPackTip}" ToolTipService.ShowOnDisabled="True" DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" Margin="0,1,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:T 'Server pack'}"/>
                            </StackPanel>
                        </Button>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{Binding SelectedVersion.Version.Name}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap">
                                            <Run Text="{Binding SelectedVersion.Version.VersionNumber, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SelectedVersion.Version.GameVersionsText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBlock DockPanel.Dock="Top" Text="{l:T 'CHANGELOG'}" Style="{StaticResource Overline}" Margin="18,14,0,6"/>
                            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Margin="18,0,18,6" Visibility="{Binding LoadingChangelog, Converter={StaticResource VisibleIf}}"/>
                            <c:HtmlView Html="{Binding ChangelogHtml}" Margin="18,0,4,4"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Sidebar ===== -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,20">
            <StackPanel>
                <!-- Install (Discover) -->
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14" Visibility="{Binding IsDiscoverMode, Converter={StaticResource VisibleIf}}">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Install'}" Style="{StaticResource H3}" Margin="0,0,0,12"/>
                        <TextBlock Text="{l:T 'INSTANCE NAME'}" Style="{StaticResource Overline}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T 'Instance name'}"/>
                        <TextBlock Text="{l:T 'CATEGORY'}" Style="{StaticResource Overline}" Margin="0,12,0,5"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>
                        <TextBlock Text="{l:T 'VERSION'}" Style="{StaticResource Overline}" Margin="0,12,0,5"/>
                        <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Version.VersionNumber, Mode=OneWay}"/><Run Text="  ·  " Foreground="{StaticResource Fg3}"/><Run Text="{Binding Version.GameVersionsText, Mode=OneWay}" Foreground="{StaticResource Fg2}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ActCommand}" IsEnabled="{Binding CanAct}" Margin="0,16,0,0" Padding="16,10" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Margin="0,1,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ActionText}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ServerPackCommand}" IsEnabled="{Binding HasServerPack}" ToolTip="{Binding ServerPackTip}" ToolTipService.ShowOnDisabled="True" Margin="0,8,0,0" Padding="16,9" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" Margin="0,1,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:T 'Server pack'}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Version control (instance) -->
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14" Visibility="{Binding IsInstanceMode, Converter={StaticResource VisibleIf}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource Bg3}" ClipToBounds="True" Margin="0,0,12,0">
                                <Image c:RemoteImage.DecodeWidth="96" c:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="{l:T 'Open website'}" Command="{Binding OpenWebCommand}" Width="32" Height="32" FontSize="12"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource Faint}"><Run Text="{Binding SourceText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Author, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{l:T 'INSTALLED VERSION'}" Style="{StaticResource Overline}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding InstalledVersionText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LatestText}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding UpdateToLatestCommand}" Margin="0,14,0,0" Padding="16,9" HorizontalAlignment="Stretch"
                                Visibility="{Binding HasUpdate, Converter={StaticResource VisibleIf}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" Margin="0,1,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:T 'Update to latest'}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ServerPackCommand}" IsEnabled="{Binding HasServerPack}" ToolTip="{Binding ServerPackTip}" ToolTipService.ShowOnDisabled="True" Margin="0,8,0,0" Padding="16,9" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" Margin="0,1,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:T 'Server pack'}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{l:T 'Pick any version on the Versions tab to switch to it. Worlds, screenshots and files you added are kept.'}"
                                   Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Progress -->
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:T 'Cancel'}" Style="{StaticResource GhostButton}" Padding="10,4" Command="{Binding CancelBusyCommand}"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ProgressBar Margin="0,8,0,0" Value="{Binding Progress, Converter={StaticResource Percent}, Mode=OneWay}"
                                     IsIndeterminate="{Binding Progress, Converter={StaticResource Indeterminate}, Mode=OneWay}"/>
                    </StackPanel>
                </Border>

                <!-- Info -->
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Details'}" Style="{StaticResource H3}" Margin="0,0,0,12"/>
                        <DockPanel Style="{StaticResource InfoRow}"><TextBlock Text="{l:T 'Platform'}" Style="{StaticResource InfoKey}"/><TextBlock Text="{Binding SourceText}" Style="{StaticResource InfoVal}"/></DockPanel>
                        <DockPanel Style="{StaticResource InfoRow}"><TextBlock Text="{l:T 'Downloads'}" Style="{StaticResource InfoKey}"/><TextBlock Text="{Binding Details.DownloadsText, FallbackValue='-'}" Style="{StaticResource InfoVal}"/></DockPanel>
                        <DockPanel Style="{StaticResource InfoRow}"><TextBlock Text="{l:T 'Updated'}" Style="{StaticResource InfoKey}"/><TextBlock Text="{Binding UpdatedText}" Style="{StaticResource InfoVal}"/></DockPanel>
                        <DockPanel Style="{StaticResource InfoRow}" Visibility="{Binding IsDiscoverMode, Converter={StaticResource VisibleIf}}"><TextBlock Text="{l:T 'Released'}" Style="{StaticResource InfoKey}"/><TextBlock Text="{Binding CreatedText}" Style="{StaticResource InfoVal}"/></DockPanel>
                        <DockPanel Style="{StaticResource InfoRow}"><TextBlock Text="{l:T 'Minecraft'}" Style="{StaticResource InfoKey}"/><TextBlock Text="{Binding GameVersionsText}" Style="{StaticResource InfoVal}"/></DockPanel>
                        <DockPanel Style="{StaticResource InfoRow}"><TextBlock Text="{l:T 'Loaders'}" Style="{StaticResource InfoKey}"/><TextBlock Text="{Binding Details.LoadersText, FallbackValue='-'}" Style="{StaticResource InfoVal}"/></DockPanel>
                        <DockPanel Style="{StaticResource InfoRow}"><TextBlock Text="{l:T 'License'}" Style="{StaticResource InfoKey}"/><TextBlock Text="{Binding Details.License, FallbackValue='-'}" Style="{StaticResource InfoVal}"/></DockPanel>
                        <DockPanel Style="{StaticResource InfoRow}" Margin="0"><TextBlock Text="{l:T 'Categories'}" Style="{StaticResource InfoKey}"/><TextBlock Text="{Binding Details.CategoriesText, FallbackValue='-'}" Style="{StaticResource InfoVal}"/></DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
